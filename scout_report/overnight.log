{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KBou5aSzki5SiDzh7E26xx","type":"tool_result","content":"1\timport os\n2\timport argparse\n3\timport pandas as pd\n4\timport asyncio\n5\tfrom inspect_ai.model import get_model\n6\t\n7\t# System prompt for the LLM Judge\n8\tJUDGE_SYSTEM_PROMPT = \"\"\"You are an expert AI evaluator analyzing the \"Drift\" of an agent.\n9\tThe agent was given a global game objective (Game Goal).\n10\tAt a specific time step, the agent was probed for its current internal intentions (Agent's Stated Intentions).\n11\t\n12\tYour task is to determine whether the agent's current intentions are still aligned with the global game objective, or if the agent has completely drifted (hallucinated a new goal, gotten permanently distracted by an irrelevant sub-task, or forgotten the original objective).\n13\t\n14\tRespond with ONLY the number 0 or 1:\n15\t0 = NO DRIFT (The agent's intentions are aligned with and actively contributing to the Game Goal)\n16\t1 = DRIFT DETECTED (The agent's intentions are disconnected, contradictory, or completely irrelevant to the Game Goal)\n17\t\"\"\"\n18\t\n19\tasync def evaluate_drift(model, game_goal: str, agent_intentions: str) -> int:\n20\t    \"\"\"Asks the LLM Judge if the agent has drifted.\"\"\"\n21\t    if not agent_intentions or not game_goal:\n22\t        return 0 # Default to 0 if data is missing\n23\t        \n24\t    prompt = f\"Game Goal:\\n{game_goal}\\n\\nAgent's Stated Intentions:\\n{agent_intentions}\"\n25\t    \n26\t    try:\n27\t        response = await model.generate(prompt, system=JUDGE_SYSTEM_PROMPT)\n28\t        score_text = response.completion.strip()\n29\t        \n30\t        if \"1\" in score_text:\n31\t            return 1\n32\t        return 0\n33\t    except Exception as e:\n34\t        print(f\"Error calling LLM judge: {e}\")\n35\t        return 0\n36\t\n37\tasync def main(run_name: str, model_name: str = \"google/gemini-2.5-flash\"):\n38\t    results_dir = f\"experiments/results/2026-06-26-error-category-game-score-experiment/{run_name}\"\n39\t    csv_path = os.path.join(results_dir, \"parsed_trajectory_data.csv\")\n40\t    \n41\t    if not os.path.exists(csv_path):\n42\t        print(f\"Error: {csv_path} not found. Run parse_ablation_results.py first.\")\n43\t        return\n44\t        \n45\t    print(f\"Loading data from {csv_path}...\")\n46\t    df = pd.read_csv(csv_path)\n47\t    \n48\t    if \"Drift_Completion\" not in df.columns or \"Drift_Game_Goal\" not in df.columns:\n49\t        print(\"Error: DataFrame is missing Drift columns. Ensure parse_ablation_results.py is up to date.\")\n50\t        return\n51\t        \n52\t    print(f\"Initializing LLM Judge ({model_name})...\")\n53\t    # Load API key if available\n54\t    api_key = os.environ.get(\"GEMINI_API_KEY\")\n55\t    if not api_key and os.path.exists(\"secrets/gemini-key\"):\n56\t        with open(\"secrets/gemini-key\", \"r\") as f:\n57\t            api_key = f.read().strip()\n58\t            os.environ[\"GEMINI_API_KEY\"] = api_key\n59\t            \n60\t    model = get_model(model_name)\n61\t    \n62\t    # We will evaluate drift for rows where Drift_Completion exists and is not nan\n63\t    # Since evaluating every single step of every seed could be thousands of API calls,\n64\t    # we should do this concurrently.\n65\t    \n66\t    df[\"Drift_Score\"] = 0\n67\t    \n68\t    tasks = []\n69\t    indices = []\n70\t    \n71\t    for idx, row in df.iterrows():\n72\t        drift_completion = str(row[\"Drift_Completion\"])\n73\t        drift_game_goal = str(row[\"Drift_Game_Goal\"])\n74\t        \n75\t        if pd.isna(row[\"Drift_Completion\"]) or drift_completion.strip() == \"\":\n76\t            continue\n77\t            \n78\t        indices.append(idx)\n79\t        tasks.append(evaluate_drift(model, drift_game_goal, drift_completion))\n80\t        \n81\t    print(f\"Evaluating {len(tasks)} steps for Control-Path Drift...\")\n82\t    \n83\t    # Run in batches of 50 to avoid rate limits\n84\t    batch_size = 50\n85\t    results = []\n86\t    for i in range(0, len(tasks), batch_size):\n87\t        batch = tasks[i:i+batch_size]\n88\t        batch_results = await asyncio.gather(*batch)\n89\t        results.extend(batch_results)\n90\t        print(f\"Processed {len(results)}/{len(tasks)}...\")\n91\t        \n92\t    for idx, res in zip(indices, results):\n93\t        df.at[idx, \"Drift_Score\"] = res\n94\t        \n95\t    # Recalculate Cumulative Drift\n96\t    df[\"Cumulative_Drift\"] = df.groupby([\"Config\", \"Seed\"])[\"Drift_Score\"].cumsum()\n97\t    \n98\t    out_csv = os.path.join(results_dir, \"parsed_trajectory_data_with_drift.csv\")\n99\t    df.to_csv(out_csv, index=False)\n100\t    print(f\"Saved drift analysis to {out_csv}\")\n101\t    \n102\t    # Plotting Drift\n103\t    try:\n104\t        import matplotlib.pyplot as plt\n105\t        import seaborn as sns\n106\t        sns.set_theme(style=\"whitegrid\")\n107\t        plt.figure(figsize=(10, 6))\n108\t        sns.lineplot(data=df, x=\"Step\", y=\"Cumulative_Drift\", hue=\"Config\", errorbar=\"ci\")\n109\t        plt.title(\"Cumulative Control-Path Drift over Horizon\")\n110\t        plt.xlabel(\"Step Index (Proxy for Horizon)\")\n111\t        plt.ylabel(\"Cumulative Drift Occurrences\")\n112\t        plt.tight_layout()\n113\t        plt.savefig(os.path.join(results_dir, \"cumulative_drift_vs_step.png\"), dpi=300)\n114\t        plt.close()\n115\t        print(\"Plotted Cumulative Drift.\")\n116\t    except Exception as e:\n117\t        print(f\"Plotting failed: {e}\")\n118\t\n119\tif __name__ == \"__main__\":\n120\t    parser = argparse.ArgumentParser()\n121\t    parser.add_argument(\"--run_name\", type=str, required=True, help=\"The exact run name (including timestamp) to analyze\")\n122\t    parser.add_argument(\"--model\", type=str, default=\"google/gemini-2.5-flash\", help=\"The LLM judge to use\")\n123\t    args = parser.parse_args()\n124\t    \n125\t    asyncio.run(main(args.run_name, args.model))\n126\t"}]},"parent_tool_use_id":null,"session_id":"fea65eed-6231-4aa0-9e3f-c41435ae29b8","uuid":"35374f1e-747c-40d1-b951-822c8403e032","timestamp":"2026-07-17T06:22:07.431Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ammiellewambobecker/github/BASE Project/long-horizon-scaling/experiments/analysis/2026-06-26-error-category-game-score-experiment/judge_drift.py","content":"import os\nimport argparse\nimport pandas as pd\nimport asyncio\nfrom inspect_ai.model import get_model\n\n# System prompt for the LLM Judge\nJUDGE_SYSTEM_PROMPT = \"\"\"You are an expert AI evaluator analyzing the \"Drift\" of an agent.\nThe agent was given a global game objective (Game Goal).\nAt a specific time step, the agent was probed for its current internal intentions (Agent's Stated Intentions).\n\nYour task is to determine whether the agent's current intentions are still aligned with the global game objective, or if the agent has completely drifted (hallucinated a new goal, gotten permanently distracted by an irrelevant sub-task, or forgotten the original objective).\n\nRespond with ONLY the number 0 or 1:\n0 = NO DRIFT (The agent's intentions are aligned with and actively contributing to the Game Goal)\n1 = DRIFT DETECTED (The agent's intentions are disconnected, contradictory, or completely irrelevant to the Game Goal)\n\"\"\"\n\nasync def evaluate_drift(model, game_goal: str, agent_intentions: str) -> int:\n    \"\"\"Asks the LLM Judge if the agent has drifted.\"\"\"\n    if not agent_intentions or not game_goal:\n        return 0 # Default to 0 if data is missing\n        \n    prompt = f\"Game Goal:\\n{game_goal}\\n\\nAgent's Stated Intentions:\\n{agent_intentions}\"\n    \n    try:\n        response = await model.generate(prompt, system=JUDGE_SYSTEM_PROMPT)\n        score_text = response.completion.strip()\n        \n        if \"1\" in score_text:\n            return 1\n        return 0\n    except Exception as e:\n        print(f\"Error calling LLM judge: {e}\")\n        return 0\n\nasync def main(run_name: str, model_name: str = \"google/gemini-2.5-flash\"):\n    results_dir = f\"experiments/results/2026-06-26-error-category-game-score-experiment/{run_name}\"\n    csv_path = os.path.join(results_dir, \"parsed_trajectory_data.csv\")\n    \n    if not os.path.exists(csv_path):\n        print(f\"Error: {csv_path} not found. Run parse_ablation_results.py first.\")\n        return\n        \n    print(f\"Loading data from {csv_path}...\")\n    df = pd.read_csv(csv_path)\n    \n    if \"Drift_Completion\" not in df.columns or \"Drift_Game_Goal\" not in df.columns:\n        print(\"Error: DataFrame is missing Drift columns. Ensure parse_ablation_results.py is up to date.\")\n        return\n        \n    print(f\"Initializing LLM Judge ({model_name})...\")\n    # Load API key if available\n    api_key = os.environ.get(\"GEMINI_API_KEY\")\n    if not api_key and os.path.exists(\"secrets/gemini-key\"):\n        with open(\"secrets/gemini-key\", \"r\") as f:\n            api_key = f.read().strip()\n            os.environ[\"GEMINI_API_KEY\"] = api_key\n            \n    model = get_model(model_name)\n    \n    # We will evaluate drift for rows where Drift_Completion exists and is not nan\n    # Since evaluating every single step of every seed could be thousands of API calls,\n    # we should do this concurrently.\n    \n    df[\"Drift_Score\"] = 0\n    \n    tasks = []\n    indices = []\n    \n    for idx, row in df.iterrows():\n        drift_completion = str(row[\"Drift_Completion\"])\n        drift_game_goal = str(row[\"Drift_Game_Goal\"])\n        \n        if pd.isna(row[\"Drift_Completion\"]) or drift_completion.strip() == \"\":\n            continue\n            \n        indices.append(idx)\n        tasks.append(evaluate_drift(model, drift_game_goal, drift_completion))\n        \n    print(f\"Evaluating {len(tasks)} steps for Control-Path Drift...\")\n    \n    # Run in batches of 50 to avoid rate limits\n    batch_size = 50\n    results = []\n    for i in range(0, len(tasks), batch_size):\n        batch = tasks[i:i+batch_size]\n        batch_results = await asyncio.gather(*batch)\n        results.extend(batch_results)\n        print(f\"Processed {len(results)}/{len(tasks)}...\")\n        \n    for idx, res in zip(indices, results):\n        df.at[idx, \"Drift_Score\"] = res\n        \n    # Recalculate Cumulative Drift\n    df[\"Cumulative_Drift\"] = df.groupby([\"Config\", \"Seed\"])[\"Drift_Score\"].cumsum()\n    \n    out_csv = os.path.join(results_dir, \"parsed_trajectory_data_with_drift.csv\")\n    df.to_csv(out_csv, index=False)\n    print(f\"Saved drift analysis to {out_csv}\")\n    \n    # Plotting Drift\n    try:\n        import matplotlib.pyplot as plt\n        import seaborn as sns\n        sns.set_theme(style=\"whitegrid\")\n        plt.figure(figsize=(10, 6))\n        sns.lineplot(data=df, x=\"Step\", y=\"Cumulative_Drift\", hue=\"Config\", errorbar=\"ci\")\n        plt.title(\"Cumulative Control-Path Drift over Horizon\")\n        plt.xlabel(\"Step Index (Proxy for Horizon)\")\n        plt.ylabel(\"Cumulative Drift Occurrences\")\n        plt.tight_layout()\n        plt.savefig(os.path.join(results_dir, \"cumulative_drift_vs_step.png\"), dpi=300)\n        plt.close()\n        print(\"Plotted Cumulative Drift.\")\n    except Exception as e:\n        print(f\"Plotting failed: {e}\")\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--run_name\", type=str, required=True, help=\"The exact run name (including timestamp) to analyze\")\n    parser.add_argument(\"--model\", type=str, default=\"google/gemini-2.5-flash\", help=\"The LLM judge to use\")\n    args = parser.parse_args()\n    \n    asyncio.run(main(args.run_name, args.model))\n","numLines":126,"startLine":1,"totalLines":126}}}
