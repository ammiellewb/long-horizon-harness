canner so the rubric is\\n5\\tbrowsable in `scout view` and queryable via `scan_results_df`, instead of a\\n6\\tone-off pandas script.\\n7\\t\\n8\\tReads each transcript's `metadata['trajectory_telemetry']` (the per-step\\n9\\t`probe_results` recorded by the harness during the eval run) and scores five\\n10\\tfailure channels + final game score, emitting one Result per transcript.\\n11\\t\\n12\\tRun (from repo root, with the inspect venv):\\n13\\t    .venv-inspect/bin/scout scan scout_report/cooking_rubric.py \\\\\\n14\\t        -T flash_lite_eval_20260627_09354 --scans scout_report/scans\\n15\\t\\\"\\\"\\\"\\n16\\timport string\\n17\\t\\n18\\tfrom inspect_scout import Result, Scanner, Transcript, scanner\\n19\\t\\n20\\t\\n21\\t# --- ported verbatim from parse_ablation_results.py -------------------------\\n22\\tdef clean_item_name(item: str) -> str:\\n23\\t    item = item.lower().strip()\\n24\\t    item = item.translate(str.maketrans(\\\"\\\", \\\"\\\", string.punctuation))\\n25\\t    for p in (\\\"a \\\", \\\"an \\\", \\\"the \\\", \\\"some \\\"):\\n26\\t        if item.startswith(p):\\n27\\t            item = item[len(p):]\\n28\\t    return item.strip()\\n29\\t\\n30\\t\\n31\\tdef calculate_ale(completion: str, ground_truth: list) -> int:\\n32\\t    \\\"\\\"\\\"Count hallucinated (FP) + forgotten (FN) items vs ground truth.\\\"\\\"\\\"\\n33\\t    lines = [clean_item_name(x) for x in completion.split(\\\"\\\\n\\\") if x.strip()]\\n34\\t    if len(lines) == 1 and lines[0] == \\\"nothing\\\":\\n35\\t        lines = []\\n36\\t    gt = [clean_item_name(x) for x in ground_truth]\\n37\\t    errors = 0\\n38\\t    for g in gt:                                  # false negatives (forgotten)\\n39\\t        if not any(g in c for c in lines):\\n40\\t            errors += 1\\n41\\t    for c in lines:                               # false positives (hallucinated)\\n42\\t        if not any(g in c for g in gt):\\n43\\t            errors += 1\\n44\\t    return errors\\n45\\t\\n46\\t\\n47\\tPARSER_REJECTIONS = (\\n48\\t    \\\"i don't understand\\\", \\\"that sentence isn't one i recognize\\\",\\n49\\t    \\\"you can't see any such thing\\\", \\\"there is no\\\", \\\"i don't know the word\\\",\\n50\\t    \\\"what do you want to\\\", \\\"nothing happens\\\",\\n51\\t)\\n52\\t\\n53\\t\\n54\\tdef _rubric(tele: list) -> dict:\\n55\\t    \\\"\\\"\\\"Compute cumulative channel counts from trajectory telemetry.\\\"\\\"\\\"\\n56\\t    ale_spatial = ale_recipe = interface = liveness = info_seek = 0\\n57\\t    action_hist: list[str] = []\\n58\\t    for step in tele:\\n59\\t        action = (step.get(\\\"action_sent\\\") or \\\"\\\").strip()\\n60\\t        valid = step.get(\\\"valid_actions\\\") or []\\n61\\t        obs = (step.get(\\\"observation_received\\\") or \\\"\\\").lower()\\n62\\t\\n63\\t        for pr in step.get(\\\"probe_results\\\", []):\\n64\\t            if pr.get(\\\"probe\\\") != \\\"ale\\\":\\n65\\t                continue\\n66\\t            comp = pr.get(\\\"completion\\\", \\\"\\\")\\n67\\t            gt = (pr.get(\\\"metadata\\\") or {}).get(\\\"ground_truth\\\", []) or []\\n68\\t            errs = calculate_ale(comp, gt)\\n69\\t            qid = pr.get(\\\"id\\\", pr.get(\\\"question_id\\\", \\\"\\\"))\\n70\\t            if str(qid).startswith(\\\"recipe\\\"):\\n71\\t                ale_recipe += errs\\n72\\t            else:\\n73\\t                ale_spatial += errs\\n74\\t\\n75\\t        if action and valid and action not in valid:\\n76\\t            interface += 1\\n77\\t        action_hist.append(action)\\n78\\t        if len(action_hist) >= 4 and len(set(action_hist[-4:])) == 1:\\n79\\t            liveness += 1\\n80\\t        if len(action_hist) >= 2:\\n81\\t            prev = action_hist[-2]\\n82\\t            if prev.startswith(\\\"go \\\") or prev.startswith(\\\"open door to\\\"):\\n83\\t                if not any(action.startswith(p) for p in (\\\"look\\\", \\\"examine\\\", \\\"inventory\\\", \\\"read\\\")):\\n84\\t                    info_seek += 1\\n85\\t    return {\\n86\\t        \\\"ale_spatial\\\": ale_spatial, \\\"ale_recipe\\\": ale_recipe,\\n87\\t        \\\"interface\\\": interface, \\\"liveness\\\": liveness, \\\"info_seek\\\": info_seek,\\n88\\t        \\\"steps\\\": len(tele),\\n89\\t    }\\n90\\t\\n91\\t\\n92\\t@scanner(messages=\\\"all\\\")\\n93\\tdef cooking_rubric() -> Scanner[Transcript]:\\n94\\t    \\\"\\\"\\\"Score CookingWorld failure channels from harness telemetry.\\\"\\\"\\\"\\n95\\t\\n96\\t    async def scan(transcript: Transcript) -> Result:\\n97\\t        md = transcript.metadata or {}\\n98\\t        # Inspect nests the eval sample's own metadata under \\\"sample_metadata\\\";\\n99\\t        # the harness stored trajectory_telemetry + final_score there.\\n100\\t        sm = md.get(\\\"sample_metadata\\\", md) or md\\n101\\t        tele = sm.get(\\\"trajectory_telemetry\\\", []) or []\\n102\\t        final_score = sm.get(\\\"final_score\\\", md.get(\\\"score_harness_scorer\\\", 0.0))\\n103\\t\\n104\\t        if not tele:\\n105\\t            return Result(\\n106\\t                value=float(final_score),\\n107\\t                answer=\\\"no telemetry\\\",\\n108\\t                label=\\\"no_telemetry\\\",\\n109\\t                explanation=\\\"metadata carried no trajectory_telemetry; \\\"\\n110\\t                            f\\\"available keys: {sorted(md.keys())[:12]}\\\",\\n111\\t            )\\n112\\t\\n113\\t        r = _rubric(tele)\\n114\\t        total_ale = r[\\\"ale_spatial\\\"] + r[\\\"ale_recipe\\\"]\\n115\\t        return Result(\\n116\\t            value=float(final_score),\\n117\\t            answer=(f\\\"score={final_score:.2f} | ALE={total_ale} \\\"\\n118\\t                    f\\\"(spatial {r['ale_spatial']}/recipe {r['ale_recipe']}) \\\"\\n119\\t                    f\\\"interface={r['interface']} liveness={r['liveness']} \\\"\\n120\\t                    f\\\"info_seek={r['info_seek']} over {r['steps']} steps\\\"),\\n121\\t            label=\\\"scored\\\",\\n122\\t            explanation=(f\\\"Failure-channel rubric over {r['steps']} steps. \\\"\\n123\\t                         f\\\"Final game score {final_score:.3f}.\\\"),\\n124\\t            metadata={\\\"final_score\\\": final_score, **r,\\n125\\t                      \\\"total_ale\\\": total_ale},\\n126\\t        )\\n127\\t\\n128\\t    return scan\\n129\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fea65eed-6231-4aa0-9e3f-c41435ae29b8\",\"uuid\":\"723c2f79-45a7-4d28-8227-250106539350\",\"timestamp\":\"2026-07-17T06:21:49.222Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/ammiellewambobecker/github/BASE Project/scout_report/cooking_rubric.py\",\"content\":\"\\\"\\\"\\\"Scout scanner: failure-channel rubric for CookingWorld ablation eval logs.\\n\\nPorts dignissimus's per-step channel metrics (long-horizon-scaling\\n`parse_ablation_results.py`) into an Inspect Scout scanner so the rubric is\\nbrowsable in `scout view` and queryable via `scan_results_df`, instead of a\\none-off pandas script.\\n\\nReads each transcript's `metadata['trajectory_telemetry']` (the per-step\\n`probe_results` recorded by the harness during the eval run) and scores five\\nfailure channels + final game score, emitting one Result per transcript.\\n\\nRun (from repo root, with the inspect venv):\\n    .venv-inspect/bin/scout scan scout_report/cooking_rubric.py \\\\\\n        -T flash_lite_eval_20260627_09354 --scans scout_report/scans\\n\\\"\\\"\\\"\\nimport string\\n\\nfrom inspect_scout import Result, Scanner, Transcript, scanner\\n\\n\\n# --- ported verbatim from parse_ablation_results.py -------------------------\\ndef clean_item_name(item: str) -> str:\\n    item = item.lower().strip()\\n    item = item.translate(str.maketrans(\\\"\\\", \\\"\\\", string.punctuation))\\n    for p in (\\\"a \\\", \\\"an \\\", \\\"the \\\", \\\"some \\\"):\\n        if item.startswith(p):\\n            item = item[len(p):]\\n    return item.strip()\\n\\n\\ndef calculate_ale(completion: str, ground_truth: list) -> int:\\n    \\\"\\\"\\\"Count hallucinated (FP) + forgotten (FN) items vs ground truth.\\\"\\\"\\\"\\n    lines = [clean_item_name(x) for x in completion.split(\\\"\\\\n\\\") if x.strip()]\\n    if len(lines) == 1 and lines[0] == \\\"nothing\\\":\\n        lines = []\\n    gt = [clean_item_name(x) for x in ground_truth]\\n    errors = 0\\n    for g in gt:                                  # false negatives (forgotten)\\n        if not any(g in c for c in lines):\\n            errors += 1\\n    for c in lines:                               # false positives (hallucinated)\\n        if not any(g in c for g in gt):\\n            errors += 1\\n    return errors\\n\\n\\nPARSER_REJECTIONS = (\\n    \\\"i don't understand\\\", \\\"that sentence isn't one i recognize\\\",\\n    \\\"you can't see any such thing\\\", \\\"there is no\\\", \\\"i don't know the word\\\",\\n    \\\"what do you want to\\\", \\\"nothing happens\\\",\\n)\\n\\n\\ndef _rubric(tele: list) -> dict:\\n    \\\"\\\"\\\"Compute cumulative channel counts from trajectory telemetry.\\\"\\\"\\\"\\n    ale_spatial = ale_recipe = interface = liveness = info_seek = 0\\n    action_hist: list[str] = []\\n    for step in tele:\\n        action = (step.get(\\\"action_sent\\\") or \\\"\\\").strip()\\n        valid = step.get(\\\"valid_actions\\\") or []\\n        obs = (step.get(\\\"observation_received\\\") or \\\"\\\").lower()\\n\\n        for pr in step.get(\\\"probe_results\\\", []):\\n            if pr.get(\\\"probe\\\") != \\\"ale\\\":\\n                continue\\n            comp = pr.get(\\\"completion\\\", \\\"\\\")\\n            gt = (pr.get(\\\"metadata\\\") or {}).get(\\\"ground_truth\\\", []) or []\\n            errs = calculate_ale(comp, gt)\\n            qid = pr.get(\\\"id\\\", pr.get(\\\"question_id\\\", \\\"\\\"))\\n            if str(qid).startswith(\\\"recipe\\\"):\\n                ale_recipe += errs\\n            else:\\n                ale_spatial += errs\\n\\n        if action and valid and action not in valid:\\n            interface += 1\\n        action_hist.append(action)\\n        if len(action_hist) >= 4 and len(set(action_hist[-4:])) == 1:\\n            liveness += 1\\n        if len(action_hist) >= 2:\\n            prev = action_hist[-2]\\n            if prev.startswith(\\\"go \\\") or prev.startswith(\\\"open door to\\\"):\\n                if not any(action.startswith(p) for p in (\\\"look\\\", \\\"examine\\\", \\\"inventory\\\", \\\"read\\\")):\\n                    info_seek += 1\\n    return {\\n        \\\"ale_spatial\\\": ale_spatial, \\\"ale_recipe\\\": ale_recipe,\\n        \\\"interface\\\": interface, \\\"liveness\\\": liveness, \\\"info_seek\\\": info_seek,\\n        \\\"steps\\\": len(tele),\\n    }\\n\\n\\n@scanner(messages=\\\"all\\\")\\ndef cooking_rubric() -> Scanner[Transcript]:\\n    \\\"\\\"\\\"Score CookingWorld failure channels from harness telemetry.\\\"\\\"\\\"\\n\\n    async def scan(transcript: Transcript) -> Result:\\n        md = transcript.metadata or {}\\n        # Inspect nests the eval sample's own metadata under \\\"sample_metadata\\\";\\n        # the harness stored trajectory_telemetry + final_score there.\\n        sm = md.get(\\\"sample_metadata\\\", md) or md\\n        tele = sm.get(\\\"trajectory_telemetry\\\", []) or []\\n        final_score = sm.get(\\\"final_score\\\", md.get(\\\"score_harness_scorer\\\", 0.0))\\n\\n        if not tele:\\n            return Result(\\n                value=float(final_score),\\n                answer=\\\"no telemetry\\\",\\n                label=\\\"no_telemetry\\\",\\n                explanation=\\\"metadata carried no trajectory_telemetry; \\\"\\n                            f\\\"available keys: {sorted(md.keys())[:12]}\\\",\\n            )\\n\\n        r = _rubric(tele)\\n        total_ale = r[\\\"ale_spatial\\\"] + r[\\\"ale_recipe\\\"]\\n        return Result(\\n            value=float(final_score),\\n            answer=(f\\\"score={final_score:.2f} | ALE={total_ale} \\\"\\n                    f\\\"(spatial {r['ale_spatial']}/recipe {r['ale_recipe']}) \\\"\\n                    f\\\"interface={r['interface']} liveness={r['liveness']} \\\"\\n                    f\\\"info_seek={r['info_seek']} over {r['steps']} steps\\\"),\\n            label=\\\"scored\\\",\\n            explanation=(f\\\"Failure-channel rubric over {r['steps']} steps. \\\"\\n                         f\\\"Final game score {final_score:.3f}.\\\"),\\n            metadata={\\\"final_score\\\": final_score, **r,\\n                      \\\"total_ale\\\": total_ale},\\n        )\\n\\n    return scan\\n\",\"numLines\":129,\"startLine\":1,\"totalLines\":129}}}\n11\t{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-8\",\"id\":\"msg_011Cd79WsG8qVRUL4s8LP298\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01RDdvxHFg3jXbt7vbRPSjvK\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/ammiellewambobecker/github/BASE Project/scout_report/report.py\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":4595,\"cache_read_input_tokens\":11366,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":4595},\"output_tokens\":5,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"fea65eed-6231-4aa0-9e3f-c41435ae29b8\",\"uuid\":\"1b593249-66bd-4ac4-936a-eeffe9ab3f18\",\"request_id\":\"req_011Cd79WqzjVeez9paAwhPM7\"}\n12\t{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01RDdvxHFg3jXbt7vbRPSjvK\",\"type\":\"tool_result\",\"content\":\"1\\t\\\"\\\"\\\"Aggregate the cooking_rubric Scout scan into a per-config report.\\n2\\t\\n3\\tReads the latest scan under scout_report/scans, groups the 60 per-transcript\\n4\\tResults by ablation config, and prints score + failure-channel rates (raw and\\n5\\tper-step normalized, since cumulative channel counts scale with episode length).\\n6\\t\\n7\\t    .venv-inspect/bin/python scout_report/report.py\\n8\\t\\\"\\\"\\\"\\n9\\timport glob\\n10\\timport json\\n11\\timport sys\\n12\\t\\n13\\timport pandas as pd\\n14\\t\\n15\\tCONFIGS = [\\\"baseline-m5\\\", \\\"m3-m5\\\", \\\"m7-m5\\\", \\\"m5-m6\\\", \\\"m3-m5-m6\\\", \\\"m7-m5-m6\\\"]\\n16\\tCHANNELS = [\\\"total_ale\\\", \\\"ale_spatial\\\", \\\"ale_recipe\\\", \\\"interface\\\", \\\"liveness\\\", \\\"info_seek\\\", \\\"steps\\\"]\\n17\\t\\n18\\t\\n19\\tdef _config(uri: str) -> str:\\n20\\t    # match longest labels first so \\\"m3-m5\\\" doesn't shadow \\\"m3-m5-m6\\\"\\n21\\t    for c in sorted(CONFIGS, key=len, reverse=True):\\n22\\t        if c in str(uri):\\n23\\t            return c\\n24\\t    return \\\"?\\\"\\n25\\t\\n26\\t\\n27\\tdef _md(cell, key, default=0):\\n28\\t    if isinstance(cell, str):\\n29\\t        try:\\n30\\t            cell = json.loads(cell)\\n31\\t        except Exception:\\n32\\t            cell = {}\\n33\\t    return (cell or {}).get(key, default) if isinstance(cell, dict) else default\\n34\\t\\n35\\t\\n36\\tdef load(scan_dir: str | None = None) -> pd.DataFrame:\\n37\\t    if scan_dir is None:\\n38\\t        scan_dir = sorted(glob.glob(\\\"scout_report/scans/scan_id=*\\\"))[-1]\\n39\\t    df = pd.read_parquet(f\\\"{scan_dir}/cooking_rubric.parquet\\\")\\n40\\t    df[\\\"config\\\"] = df[\\\"transcript_source_uri\\\"].map(_config)\\n41\\t    df[\\\"final_score\\\"] = df[\\\"metadata\\\"].map(lambda m: _md(m, \\\"final_score\\\"))\\n42\\t    for k in CHANNELS:\\n43\\t        df[k] = df[\\\"metadata\\\"].map(lambda m, k=k: _md(m, k))\\n44\\t    return df\\n45\\t\\n46\\t\\n47\\tdef report(df: pd.DataFrame) -> pd.DataFrame:\\n48\\t    g = df.groupby(\\\"config\\\").agg(\\n49\\t        n=(\\\"value\\\", \\\"size\\\"),\\n50\\t        score=(\\\"fina