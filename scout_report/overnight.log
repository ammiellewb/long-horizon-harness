{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_011Cd79hom6oLMZEPxtG3k7w","type":"message","role":"assistant","content":[{"type":"text","text":"Clear enough. The integration probe fires at the same step as an action; the plan lists the \"next 3 actions\". I'll define a documented heuristic: **integration failure = the plan's first action is not executed within the current+next-3 action window**. At step 5 (\"take knife\" planned, never executed soon) → failure; at step 10 (\"move north\" = current action) → no failure. Non-trivial and sensible.\n\nNow let me rewrite the scanner with the drift judge (graceful degradation) and integration heuristic."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1944,"cache_read_input_tokens":49263,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1944},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fea65eed-6231-4aa0-9e3f-c41435ae29b8","uuid":"18d12fa4-b7b1-43d4-b0f9-851defac8f34","request_id":"req_011Cd79hmmYUD8q542rtd3Nr"}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_011Cd79hom6oLMZEPxtG3k7w","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01882XE5AWngmeoWMLbqaL9M","name":"Write","input":{"file_path":"/Users/ammiellewambobecker/github/BASE Project/scout_report/cooking_rubric.py","content":"\"\"\"Scout scanner: failure-channel rubric for CookingWorld ablation eval logs.\n\nPorts dignissimus's per-step channel metrics (long-horizon-scaling\n`parse_ablation_results.py`) into an Inspect Scout scanner so the rubric is\nbrowsable in `scout view` and queryable via `scan_results_df`, instead of a\none-off pandas script.\n\nReads each transcript's `metadata['trajectory_telemetry']` (the per-step\n`probe_results` recorded by the harness during the eval run) and scores the\nfailure channels + final game score, emitting one Result per transcript:\n\n  * ALE (spatial / recipe)  -- deterministic, from `ale` probes\n  * interface / liveness / info_seek -- deterministic action-pattern channels\n  * integration -- heuristic: did the agent's stated plan get executed?\n  * drift -- LLM-judged (0/1 per `drift` probe) via a cheap OpenRouter model,\n    ported from judge_drift.py. Skipped (drift=None) if no working key.\n\nRun (from repo root, with the inspect venv):\n    .venv-inspect/bin/scout scan scout_report/cooking_rubric.py \\\n        -T flash_lite_eval_20260627_09354 --scans scout_report/scans\n\"\"\"\nimport asyncio\nimport os\nimport string\n\nfrom inspect_scout import Result, Scanner, Transcript, scanner\n\n\n# --- ported verbatim from parse_ablation_results.py -------------------------\ndef clean_item_name(item: str) -> str:\n    item = item.lower().strip()\n    item = item.translate(str.maketrans(\"\", \"\", string.punctuation))\n    for p in (\"a \", \"an \", \"the \", \"some \"):\n        if item.startswith(p):\n            item = item[len(p):]\n    return item.strip()\n\n\ndef calculate_ale(completion: str, ground_truth: list) -> int:\n    \"\"\"Count hallucinated (FP) + forgotten (FN) items vs ground truth.\"\"\"\n    lines = [clean_item_name(x) for x in completion.split(\"\\n\") if x.strip()]\n    if len(lines) == 1 and lines[0] == \"nothing\":\n        lines = []\n    gt = [clean_item_name(x) for x in ground_truth]\n    errors = 0\n    for g in gt:                                  # false negatives (forgotten)\n        if not any(g in c for c in lines):\n            errors += 1\n    for c in lines:                               # false positives (hallucinated)\n        if not any(g in c for g in gt):\n            errors += 1\n    return errors\n\n\nPARSER_REJECTIONS = (\n    \"i don't understand\", \"that sentence isn't one i recognize\",\n    \"you can't see any such thing\", \"there is no\", \"i don't know the word\",\n    \"what do you want to\", \"nothing happens\",\n)\n\n\n# --- integration heuristic --------------------------------------------------\ndef _plan_first_action(completion: str) -> str:\n    \"\"\"Extract the first planned action from an `integration` plan completion.\n\n    The probe asks for a numbered 3-step plan (\"1. take knife\\n2. ...\"); we\n    take line 1, strip its \"1.\" / \"1)\" numbering, and normalize.\n    \"\"\"\n    for line in completion.split(\"\\n\"):\n        line = line.strip()\n        if not line:\n            continue\n        # strip a leading list marker like \"1.\", \"1)\", \"-\", \"*\"\n        for i, ch in enumerate(line):\n            if ch.isdigit() or ch in \".)-* \\t\":\n                continue\n            line = line[i:]\n            break\n        return line.strip().lower()\n    return \"\"\n\n\ndef _action_matches(plan: str, executed: str) -> bool:\n    \"\"\"Loose match between a planned action and an executed one.\"\"\"\n    if not plan or not executed:\n        return False\n    plan, executed = plan.strip().lower(), executed.strip().lower()\n    return plan == executed or plan in executed or executed in plan\n\n\ndef _rubric(tele: list) -> dict:\n    \"\"\"Compute cumulative channel counts from trajectory telemetry.\n\n    Deterministic channels only; also collects the raw `drift` probes (game\n    goal + stated intentions) for the async LLM judge to score afterwards.\n    \"\"\"\n    ale_spatial = ale_recipe = interface = liveness = info_seek = 0\n    integration = 0\n    action_hist: list[str] = []\n    drift_probes: list[dict] = []      # {game_goal, completion} for the judge\n    # (step_index, planned_first_action) pending an execution-window check\n    pending_plans: list[tuple[int, str]] = []\n\n    for i, step in enumerate(tele):\n        action = (step.get(\"action_sent\") or \"\").strip()\n        valid = step.get(\"valid_actions\") or []\n\n        for pr in step.get(\"probe_results\", []):\n            probe = pr.get(\"probe\")\n            if probe == \"ale\":\n                comp = pr.get(\"completion\", \"\")\n                gt = (pr.get(\"metadata\") or {}).get(\"ground_truth\", []) or []\n                errs = calculate_ale(comp, gt)\n                qid = pr.get(\"question_id\", pr.get(\"id\", \"\"))\n                if str(qid).startswith(\"recipe\"):\n                    ale_recipe += errs\n                else:\n                    ale_spatial += errs\n            elif probe == \"drift\":\n                drift_probes.append({\n                    \"game_goal\": (pr.get(\"metadata\") or {}).get(\"game_goal\", \"\"),\n                    \"completion\": pr.get(\"completion\", \"\"),\n                })\n            elif probe == \"integration\":\n                first = _plan_first_action(pr.get(\"completion\", \"\"))\n                if first:\n                    pending_plans.append((i, first))\n\n        if action and valid and action not in valid:\n            interface += 1\n        action_hist.append(action)\n        if len(action_hist) >= 4 and len(set(action_hist[-4:])) == 1:\n            liveness += 1\n        if len(action_hist) >= 2:\n            prev = action_hist[-2]\n            if prev.startswith(\"go \") or prev.startswith(\"open door to\"):\n                if not any(action.startswith(p) for p in (\"look\", \"examine\", \"inventory\", \"read\")):\n                    info_seek += 1\n\n    # Integration channel (heuristic, no ground truth): a plan is \"integrated\"\n    # if its first action is executed within the [probe_step .. +3] window.\n    # If not, the agent produced a plan then ignored it -> +1 integration error.\n    for step_i, planned in pending_plans:\n        window = [(tele[j].get(\"action_sent\") or \"\").strip()\n                  for j in range(step_i, min(step_i + 4, len(tele)))]\n        if not any(_action_matches(planned, a) for a in window):\n            integration += 1\n\n    return {\n        \"ale_spatial\": ale_spatial, \"ale_recipe\": ale_recipe,\n        \"interface\": interface, \"liveness\": liveness, \"info_seek\": info_seek,\n        \"integration\": integration, \"n_integration_probes\": len(pending_plans),\n        \"steps\": len(tele), \"drift_probes\": drift_probes,\n    }\n\n\n# --- drift LLM judge (ported from judge_drift.py) ---------------------------\nJUDGE_MODEL = \"openrouter/openai/gpt-oss-120b\"\nJUDGE_SYSTEM_PROMPT = \"\"\"You are an expert AI evaluator analyzing the \"Drift\" of an agent.\nThe agent was given a global game objective (Game Goal).\nAt a specific time step, the agent was probed for its current internal intentions (Agent's Stated Intentions).\n\nYour task is to determine whether the agent's current intentions are still aligned with the global game objective, or if the agent has completely drifted (hallucinated a new goal, gotten permanently distracted by an irrelevant sub-task, or forgotten the original objective).\n\nRespond with ONLY the number 0 or 1:\n0 = NO DRIFT (The agent's intentions are aligned with and actively contributing to the Game Goal)\n1 = DRIFT DETECTED (The agent's intentions are disconnected, contradictory, or completely irrelevant to the Game Goal)\n\"\"\"\nMAX_DRIFT_JUDGE = 5   # cost cap: at most 5 drift probes judged per transcript\n\n# Shared, lazily-initialized judge. `state` is one of:\n#   \"unknown\" -> not yet probed; \"ok\" -> usable; anything else -> disabled note.\n_JUDGE = {\"model\": None, \"state\": \"unknown\", \"note\": \"\"}\n_JUDGE_LOCK = asyncio.Lock()\n\n\nasync def _get_judge():\n    \"\"\"Return a working judge model, or None with a recorded reason.\n\n    Does a single preflight generate the first time it is called so that an\n    absent/invalid OPENROUTER_API_KEY disables the judge for the whole run\n    (drift=None everywhere) instead of failing 60 scans or burning API calls.\n    \"\"\"\n    async with _JUDGE_LOCK:\n        if _JUDGE[\"state\"] == \"ok\":\n            return _JUDGE[\"model\"]\n        if _JUDGE[\"state\"] != \"unknown\":\n            return None  # already determined unusable\n\n        if not os.environ.get(\"OPENROUTER_API_KEY\"):\n            _JUDGE[\"state\"] = \"no_key\"\n            _JUDGE[\"note\"] = \"OPENROUTER_API_KEY unset; drift judge skipped.\"\n            return None\n        try:\n            from inspect_ai.model import get_model\n            model = get_model(JUDGE_MODEL)\n            await _judge_one(model, \"test\", \"test\")  # preflight\n        except Exception as e:  # auth/connection/etc. -> disable gracefully\n            _JUDGE[\"state\"] = \"error\"\n            _JUDGE[\"note\"] = f\"drift judge unavailable ({type(e).__name__}: {e})\"\n            return None\n        _JUDGE[\"model\"] = model\n        _JUDGE[\"state\"] = \"ok\"\n        return model\n\n\nasync def _judge_one(model, game_goal: str, intentions: str) -> int:\n    from inspect_ai.model import ChatMessageSystem, ChatMessageUser\n    if not intentions or not game_goal:\n        return 0\n    prompt = (f\"Game Goal:\\n{game_goal}\\n\\n\"\n              f\"Agent's Stated Intentions:\\n{intentions}\")\n    resp = await model.generate([\n        ChatMessageSystem(content=JUDGE_SYSTEM_PROMPT),\n        ChatMessageUser(content=prompt),\n    ])\n    return 1 if \"1\" in resp.completion.strip() else 0\n\n\ndef _even_sample(items: list, k: int) -> list:\n    \"\"\"Evenly-spaced sample of at most k items (order preserved).\"\"\"\n    if len(items) <= k:\n        return items\n    step = len(items) / k\n    return [items[int(i * step)] for i in range(k)]\n\n\nasync def _judge_drift(drift_probes: list) -> tuple:\n    \"\"\"Return (cumulative_drift or None, note). None => judge unavailable.\"\"\"\n    if not drift_probes:\n        return 0, \"\"\n    model = await _get_judge()\n    if model is None:\n        return None, _JUDGE[\"note\"]\n    sampled = _even_sample(drift_probes, MAX_DRIFT_JUDGE)\n    try:\n        scores = await asyncio.gather(*[\n            _judge_one(model, p[\"game_goal\"], p[\"completion\"]) for p in sampled\n        ])\n    except Exception as e:\n        return None, f\"drift judge failed mid-run ({type(e).__name__}: {e})\"\n    return sum(scores), f\"judged {len(sampled)}/{len(drift_probes)} drift probes\"\n\n\n@scanner(messages=\"all\")\ndef cooking_rubric() -> Scanner[Transcript]:\n    \"\"\"Score CookingWorld failure channels from harness telemetry.\"\"\"\n\n    async def scan(transcript: Transcript) -> Result:\n        md = transcript.metadata or {}\n        # Inspect nests the eval sample's own metadata under \"sample_metadata\";\n        # the harness stored trajectory_telemetry + final_score there.\n        sm = md.get(\"sample_metadata\", md) or md\n        tele = sm.get(\"trajectory_telemetry\", []) or []\n        final_score = sm.get(\"final_score\", md.get(\"score_harness_scorer\", 0.0))\n\n        if not tele:\n            return Result(\n                value=float(final_score),\n                answer=\"no telemetry\",\n                label=\"no_telemetry\",\n                explanation=\"metadata carried no trajectory_telemetry; \"\n                            f\"available keys: {sorted(md.keys())[:12]}\",\n            )\n\n        r = _rubric(tele)\n        drift_probes = r.pop(\"drift_probes\")\n        total_ale = r[\"ale_spatial\"] + r[\"ale_recipe\"]\n        drift, drift_note = await _judge_drift(drift_probes)\n\n        drift_str = \"None (skipped)\" if drift is None else str(drift)\n        return Result(\n            value=float(final_score),\n            answer=(f\"score={final_score:.2f} | ALE={total_ale} \"\n                    f\"(spatial {r['ale_spatial']}/recipe {r['ale_recipe']}) \"\n                    f\"interface={r['interface']} liveness={r['liveness']} \"\n                    f\"info_seek={r['info_seek']} integration={r['integration']} \"\n                    f\"drift={drift_str} over {r['steps']} steps\"),\n            label=\"scored\",\n            explanation=(f\"Failure-channel rubric over {r['steps']} steps. \"\n                         f\"Final game score {final_score:.3f}. \"\n                         f\"Drift: {drift_note or 'no drift probes'}.\"),\n            metadata={\"final_score\": final_score, **r,\n                      \"total_ale\": total_ale,\n                      \"drift\": drift, \"n_drift_probes\": len(drift_probes),\n                      \"drift_note\": drift_note},\n        )\n\n    return scan\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1944,"cache_read_input_tokens":49263,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1944},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fea65eed-6231-4aa0-9e3f-c41435ae29b8","uuid":"0b1c5955-7d7a-4cdd-b3d9-bf897221ec05","request_id":"req_011Cd79hmmYUD8q542rtd3Nr"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01882XE5AWngmeoWMLbqaL9M","type":"tool_result","content":"The file /Users/ammiellewambobecker/github/BASE Project/scout_report/cooking_rubric.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"fea65eed-6231-4aa0-9e3f-c41435ae29b8","uuid":"559cb695-c72e-4eee-a466-4dc94d6000e5","timestamp":"2026-07-17T06:25:29.699Z","tool_use_result":{"type":"update","filePath":"/Users/ammiellewambobecker/github/BASE Project/scout_report/cooking_rubric.py","content":"\"\"\"Scout scanner: failure-channel rubric for CookingWorld ablation eval logs.\n\nPorts dignissimus's per-step channel metrics (long-horizon-scaling\n`parse_ablation_results.py`) into an Inspect Scout scanner so the rubric is\nbrowsable in `scout view` and queryable via `scan_results_df`, instead of a\none-off pandas script.\n\nReads each transcript's `metadata['trajectory_telemetry']` (the per-step\n`probe_results` recorded by the harness during the eval run) and scores the\nfailure channels + final game score, emitting one Result per transcript:\n\n  * ALE (spatial / recipe)  -- deterministic, from `ale` probes\n  * interface / liveness / info_seek -- deterministic action-pattern channels\n  * integration -- heuristic: did the agent's stated plan get executed?\n  * drift -- LLM-judged (0/1 per `drift` probe) via a cheap OpenRouter model,\n    ported from judge_drift.py. Skipped (drift=None) if no working key.\n\nRun (from repo root, with the inspect venv):\n    .venv-inspect/bin/scout scan scout_report/cooking_rubric.py \\\n        -T flash_lite_eval_20260627_09354 --scans scout_report/scans\n\"\"\"\nimport asyncio\nimport os\nimport string\n\nfrom inspect_scout import Result, Scanner, Transcript, scanner\n\n\n# --- ported verbatim from parse_ablation_results.py -------------------------\ndef clean_item_name(item: str) -> str:\n    item = item.lower().strip()\n    item = item.translate(str.maketrans(\"\", \"\", string.punctuation))\n    for p in (\"a \", \"an \", \"the \", \"some \"):\n        if item.startswith(p):\n            item = item[len(p):]\n    return item.strip()\n\n\ndef calculate_ale(completion: str, ground_truth: list) -> int:\n    \"\"\"Count hallucinated (FP) + forgotten (FN) items vs ground truth.\"\"\"\n    lines = [clean_item_name(x) for x in completion.split(\"\\n\") if x.strip()]\n    if len(lines) == 1 and lines[0] == \"nothing\":\n        lines = []\n    gt = [clean_item_name(x) for x in ground_truth]\n    errors = 0\n    for g in gt:                                  # false negatives (forgotten)\n        if not any(g in c for c in lines):\n            errors += 1\n    for c in lines:                               # false positives (hallucinated)\n        if not any(g in c for g in gt):\n            errors += 1\n    return errors\n\n\nPARSER_REJECTIONS = (\n    \"i don't understand\", \"that sentence isn't one i recognize\",\n    \"you can't see any such thing\", \"there is no\", \"i don't know the word\",\n    \"what do you want to\", \"nothing happens\",\n)\n\n\n# --- integration heuristic --------------------------------------------------\ndef _plan_first_action(completion: str) -> str:\n    \"\"\"Extract the first planned action from an `integration` plan completion.\n\n    The probe asks for a numbered 3-step plan (\"1. take knife\\n2. ...\"); we\n    take line 1, strip its \"1.\" / \"1)\" numbering, and normalize.\n    \"\"\"\n    for line in completion.split(\"\\n\"):\n        line = line.strip()\n        if not line:\n            continue\n        # strip a leading list marker like \"1.\", \"1)\", \"-\", \"*\"\n        for i, ch in enumerate(line):\n            if ch.isdigit() or ch in \".)-* \\t\":\n                continue\n            line = line[i:]\n            break\n        return line.strip().lower()\n    return \"\"\n\n\ndef _action_matches(plan: str, executed: str) -> bool:\n    \"\"\"Loose match between a planned action and an executed one.\"\"\"\n    if not plan or not executed:\n        return False\n    plan, executed = plan.strip().lower(), executed.strip().lower()\n    return plan == executed or plan in executed or executed in plan\n\n\ndef _rubric(tele: list) -> dict:\n    \"\"\"Compute cumulative channel counts from trajectory telemetry.\n\n    Deterministic channels only; also collects the raw `drift` probes (game\n    goal + stated intentions) for the async LLM judge to score afterwards.\n    \"\"\"\n    ale_spatial = ale_recipe = interface = liveness = info_seek = 0\n    integration = 0\n    action_hist: list[str] = []\n    drift_probes: list[dict] = []      # {game_goal, completion} for the judge\n    # (step_index, planned_first_action) pending an execution-window check\n    pending_plans: list[tuple[int, str]] = []\n\n    for i, step in enumerate(tele):\n        action = (step.get(\"action_sent\") or \"\").strip()\n        valid = step.get(\"valid_actions\") or []\n\n        for pr in step.get(\"probe_results\", []):\n            probe = pr.get(\"probe\")\n            if probe == \"ale\":\n                comp = pr.get(\"completion\", \"\")\n                gt = (pr.get(\"metadata\") or {}).get(\"ground_truth\", []) or []\n                errs = calculate_ale(comp, gt)\n                qid = pr.get(\"question_id\", pr.get(\"id\", \"\"))\n                if str(qid).startswith(\"recipe\"):\n                    ale_recipe += errs\n                else:\n                    ale_spatial += errs\n            elif probe == \"drift\":\n                drift_probes.append({\n                    \"game_goal\": (pr.get(\"metadata\") or {}).get(\"game_goal\", \"\"),\n                    \"completion\": pr.get(\"completion\", \"\"),\n                })\n            elif probe == \"integration\":\n                first = _plan_first_action(pr.get(\"completion\", \"\"))\n                if first:\n                    pending_plans.append((i, first))\n\n        if action and valid and action not in valid:\n            interface += 1\n        action_hist.append(action)\n        if len(action_hist) >= 4 and len(set(action_hist[-4:])) == 1:\n            liveness += 1\n        if len(action_hist) >= 2:\n            prev = action_hist[-2]\n            if prev.startswith(\"go \") or prev.startswith(\"open door to\"):\n                if not any(action.startswith(p) for p in (\"look\", \"examine\", \"inventory\", \"read\")):\n                    info_seek += 1\n\n    # Integration channel (heuristic, no ground truth): a plan is \"integrated\"\n    # if its first action is executed within the [probe_step .. +3] window.\n    # If not, the agent produced a plan then ignored it -> +1 integration error.\n    for step_i, planned in pending_plans:\n        window = [(tele[j].get(\"action_sent\") or \"\").strip()\n                  for j in range(step_i, min(step_i + 4, len(tele)))]\n        if not any(_action_matches(planned, a) for a in window):\n            integration += 1\n\n    return {\n        \"ale_spatial\": ale_spatial, \"ale_recipe\": ale_recipe,\n        \"interface\": interface, \"liveness\": liveness, \"info_seek\": info_seek,\n        \"integration\": integration, \"n_integration_probes\": len(pending_plans),\n        \"steps\": len(tele), \"drift_probes\": drift_probes,\n    }\n\n\n# --- drift LLM judge (ported from judge_drift.py) ---------------------------\nJUDGE_MODEL = \"openrouter/openai/gpt-oss-120b\"\nJUDGE_SYSTEM_PROMPT = \"\"\"You are an expert AI evaluator analyzing the \"Drift\" of an agent.\nThe agent was given a global game objective (Game Goal).\nAt a specific time step, the agent was probed for its current internal intentions (Agent's Stated Intentions).\n\nYour task is to determine whether the agent's current intentions are still aligned with the global game objective, or if the agent has completely drifted (hallucinated a new goal, gotten permanently distracted by an irrelevant sub-task, or forgotten the original objective).\n\nRespond with ONLY the number 0 or 1:\n0 = NO DRIFT (The agent's intentions are aligned with and actively contributing to the Game Goal)\n1 = DRIFT DETECTED (The agent's intentions are disconnected, contradictory, or completely irrelevant to the Game Goal)\n\"\"\"\nMAX_DRIFT_JUDGE = 5   # cost cap: at most 5 drift probes judged per transcript\n\n# Shared, lazily-initialized judge. `state` is one of:\n#   \"unknown\" -> not yet probed; \"ok\" -> usable; anything else -> disabled note.\n_JUDGE = {\"model\": None, \"state\": \"unknown\", \"note\": \"\"}\n_JUDGE_LOCK = asyncio.Lock()\n\n\nasync def _get_judge():\n    \"\"\"Return a working judge model, or None with a recorded reason.\n\n    Does a single preflight generate the first time it is called so that an\n    absent/invalid OPENROUTER_API_KEY disables the judge for the whole run\n    (drift=None everywhere) instead of failing 60 scans or burning API calls.\n    \"\"\"\n    async with _JUDGE_LOCK:\n        if _JUDGE[\"state\"] == \"ok\":\n            return _JUDGE[\"model\"]\n        if _JUDGE[\"state\"] != \"unknown\":\n            return None  # already determined unusable\n\n        if not os.environ.get(\"OPENROUTER_API_KEY\"):\n            _JUDGE[\"state\"] = \"no_key\"\n            _JUDGE[\"note\"] = \"OPENROUTER_API_KEY unset; drift judge skipped.\"\n            return None\n        try:\n            from inspect_ai.model import get_model\n            model = get_model(JUDGE_MODEL)\n            await _judge_one(model, \"test\", \"test\")  # preflight\n        except Exception as e:  # auth/connection/etc. -> disable gracefully\n            _JUDGE[\"state\"] = \"error\"\n            _JUDGE[\"note\"] = f\"drift judge unavailable ({type(e).__name__}: {e})\"\n            return None\n        _JUDGE[\"model\"] = model\n        _JUDGE[\"state\"] = \"ok\"\n        return model\n\n\nasync def _judge_one(model, game_goal: str, intentions: str) -> int:\n    from inspect_ai.model import ChatMessageSystem, ChatMessageUser\n    if not intentions or not game_goal:\n        return 0\n    prompt = (f\"Game Goal:\\n{game_goal}\\n\\n\"\n              f\"Agent's Stated Intentions:\\n{intentions}\")\n    resp = await model.generate([\n        ChatMessageSystem(content=JUDGE_SYSTEM_PROMPT),\n        ChatMessageUser(content=prompt),\n    ])\n    return 1 if \"1\" in resp.completion.strip() else 0\n\n\ndef _even_sample(items: list, k: int) -> list:\n    \"\"\"Evenly-spaced sample of at most k items (order preserved).\"\"\"\n    if len(items) <= k:\n        return items\n    step = len(items) / k\n    return [items[int(i * step)] for i in range(k)]\n\n\nasync def _judge_drift(drift_probes: list) -> tuple:\n    \"\"\"Return (cumulative_drift or None, note). None => judge unavailable.\"\"\"\n    if not drift_probes:\n        return 0, \"\"\n    model = await _get_judge()\n    if model is None:\n        return None, _JUDGE[\"note\"]\n    sampled = _even_sample(drift_probes, MAX_DRIFT_JUDGE)\n    try:\n        scores = await asyncio.gather(*[\n            _judge_one(model, p[\"game_goal\"], p[\"completion\"]) for p in sampled\n        ])\n    except Exception as e:\n        return None, f\"drift judge failed mid-run ({type(e).__name__}: {e})\"\n    return sum(scores), f\"judged {len(sampled)}/{len(drift_probes)} drift probes\"\n\n\n@scanner(messages=\"all\")\ndef cooking_rubric() -> Scanner[Transcript]:\n    \"\"\"Score CookingWorld failure channels from harness telemetry.\"\"\"\n\n    async def scan(transcript: Transcript) -> Result:\n        md = transcript.metadata or {}\n        # Inspect nests the eval sample's own metadata under \"sample_metadata\";\n        # the harness stored trajectory_telemetry + final_score there.\n        sm = md.get(\"sample_metadata\", md) or md\n        tele = sm.get(\"trajectory_telemetry\", []) or []\n        final_score = sm.get(\"final_score\", md.get(\"score_harness_scorer\", 0.0))\n\n        if not tele:\n            return Result(\n                value=float(final_score),\n                answer=\"no telemetry\",\n                label=\"no_telemetry\",\n                explanation=\"metadata carried no trajectory_telemetry; \"\n                            f\"available keys: {sorted(md.keys())[:12]}\",\n            )\n\n        r = _rubric(tele)\n        drift_probes = r.pop(\"drift_probes\")\n        total_ale = r[\"ale_spatial\"] + r[\"ale_recipe\"]\n        drift, drift_note = await _judge_drift(drift_probes)\n\n        drift_str = \"None (skipped)\" if drift is None else str(drift)\n        return Result(\n            value=float(final_score),\n            answer=(f\"score={final_score:.2f} | ALE={total_ale} \"\n                    f\"(spatial {r['ale_spatial']}/recipe {r['ale_recipe']}) \"\n                    f\"interface={r['interface']} liveness={r['liveness']} \"\n                    f\"info_seek={r['info_seek']} integration={r['integration']} \"\n                    f\"drift={drift_str} over {r['steps']} steps\"),\n            label=\"scored\",\n            explanation=(f\"Failure-channel rubric over {r['steps']} steps. \"\n                         f\"Final game score {final_score:.3f}. \"\n                         f\"Drift: {drift_note or 'no drift probes'}.\"),\n            metadata={\"final_score\": final_score, **r,\n                      \"total_ale\": total_ale,\n                      \"drift\": drift, \"n_drift_probes\": len(drift_probes),\n                      \"drift_note\": drift_note},\n        )\n\n    return scan\n","structuredPatch":[{"oldStart":6,"oldLines":13,"newStart":6,"newLines":21,"lines":[" one-off pandas script."," "," Reads each transcript's `metadata['trajectory_telemetry']` (the per-step","-`probe_results` recorded by the harness during the eval run) and scores five","-failure channels + final game score, emitting one Result per transcript.","+`probe_results` recorded by the harness during the eval run) and scores the","+failure channels + final game score, emitting one Result per transcript:"," ","+  * ALE (spatial / recipe)  -- deterministic, from `ale` probes","+  * interface / liveness / info_seek -- deterministic action-pattern channels","+  * integration -- heuristic: did the agent's stated plan get executed?","+  * drift -- LLM-judged (0/1 per `drift` probe) via a cheap OpenRouter model,","+    ported from judge_drift.py. Skipped (drift=None) if no working key.","+"," Run (from repo root, with the inspect venv):","     .venv-inspect/bin/scout scan scout_report/cooking_rubric.py \\","         -T flash_lite_eval_20260627_09354 --scans scout_report/scans"," \"\"\"","+import asyncio","+import os"," import string"," "," from inspect_scout import Result, Scanner, Transcript, scanner"]},{"oldStart":51,"oldLines":26,"newStart":59,"newLines":72,"lines":[" )"," "," ","+# --- integration heuristic --------------------------------------------------","+def _plan_first_action(completion: str) -> str:","+    \"\"\"Extract the first planned action from an `integration` plan completion.","+","+    The probe asks for a numbered 3-step plan (\"1. take knife\\n2. ...\"); we","+    take line 1, strip its \"1.\" / \"1)\" numbering, and normalize.","+    \"\"\"","+    for line in completion.split(\"\\n\"):","+        line = line.strip()","+        if not line:","+            continue","+        # strip a leading list marker like \"1.\", \"1)\", \"-\", \"*\"","+        for i, ch in enumerate(line):","+            if ch.isdigit() or ch in \".)-* \\t\":","+                continue","+            line = line[i:]","+            break","+        return line.strip().lower()","+    return \"\"","+","+","+def _action_matches(plan: str, executed: str) -> bool:","+    \"\"\"Loose match between a planned action and an executed one.\"\"\"","+    if not plan or not executed:","+        return False","+    plan, executed = plan.strip().lower(), executed.strip().lower()","+    return plan == executed or plan in executed or executed in plan","+","+"," def _rubric(tele: list) -> dict:","-    \"\"\"Compute cumulative channel counts from trajectory telemetry.\"\"\"","+    \"\"\"Compute cumulative channel counts from trajectory telemetry.","+","+    Deterministic channels only; also collects the raw `drift` probes (game","+    goal + stated intentions) for the async LLM judge to score afterwards.","+    \"\"\"","     ale_spatial = ale_recipe = interface = liveness = info_seek = 0","+    integration = 0","     action_hist: list[str] = []","-    for step in tele:","+    drift_probes: list[dict] = []      # {game_goal, completion} for the judge","+    # (step_index, planned_first_action) pending an execution-window check","+    pending_plans: list[tuple[int, str]] = []","+","+    for i, step in enumerate(tele):","         action = (step.get(\"action_sent\") or \"\").strip()","         valid = step.get(\"valid_actions\") or []","-        obs = (step.get(\"observation_received\") or \"\").lower()"," ","         for pr in step.get(\"probe_results\", []):","-            if pr.get(\"probe\") != \"ale\":","-                continue","-            comp = pr.get(\"completion\", \"\")","-            gt = (pr.get(\"metadata\") or {}).get(\"ground_truth\", []) or []","-            errs = calculate_ale(comp, gt)","-            qid = pr.get(\"id\", pr.get(\"question_id\", \"\"))","-            if str(qid).startswith(\"recipe\"):","-                ale_recipe += errs","-            else:","-                ale_spatial += errs","+            probe = pr.get(\"probe\")","+            if probe == \"ale\":","+                comp = pr.get(\"completion\", \"\")","+                gt = (pr.get(\"metadata\") or {}).get(\"ground_truth\", []) or []","+                errs = calculate_ale(comp, gt)","+                qid = pr.get(\"question_id\", pr.get(\"id\", \"\"))","+                if str(qid).startswith(\"recipe\"):","+                    ale_recipe += errs","+                else:","+                    ale_spatial += errs","+            elif probe == \"drift\":","+                drift_probes.append({","+                    \"game_goal\": (pr.get(\"metadata\") or {}).get(\"game_goal\", \"\"),","+                    \"completion\": pr.get(\"completion\", \"\"),","+                })","+            elif probe == \"integration\":","+                first = _plan_first_action(pr.get(\"completion\", \"\"))","+                if first:","+                    pending_plans.append((i, first))"," ","         if action and valid and action not in valid:","             interface += 1"]},{"oldStart":82,"oldLines":13,"newStart":136,"newLines":112,"lines":["             if prev.startswith(\"go \") or prev.startswith(\"open door to\"):","                 if not any(action.startswith(p) for p in (\"look\", \"examine\", \"inventory\", \"read\")):","                     info_seek += 1","+","+    # Integration channel (heuristic, no ground truth): a plan is \"integrated\"","+    # if its first action is executed within the [probe_step .. +3] window.","+    # If not, the agent produced a plan then ignored it -> +1 integration error.","+    for step_i, planned in pending_plans:","+        window = [(tele[j].get(\"action_sent\") or \"\").strip()","+                  for j in range(step_i, min(step_i + 4, len(tele)))]","+        if not any(_action_matches(planned, a) for a in window):","+            integration += 1","+","     return {","         \"ale_spatial\": ale_spatial, \"ale_recipe\": ale_recipe,","         \"interface\": interface, \"liveness\": liveness, \"info_seek\": info_seek,","-        \"steps\": len(tele),","+        \"integration\": integration, \"n_integration_probes\": len(pending_plans),","+        \"steps\": len(tele), \"drift_probes\": drift_probes,","     }"," "," ","+# --- drift LLM judge (ported from judge_drift.py) ---------------------------","+JUDGE_MODEL = \"openrouter/openai/gpt-oss-120b\"","+JUDGE_SYSTEM_PROMPT = \"\"\"You are an expert AI evaluator analyzing the \"Drift\" of an agent.","+The agent was given a global game objective (Game Goal).","+At a specific time step, the agent was probed for its current internal intentions (Agent's Stated Intentions).","+","+Your task is to determine whether the agent's current intentions are still aligned with the global game objective, or if the agent has completely drifted (hallucinated a new goal, gotten permanently distracted by an irrelevant sub-task, or forgotten the original objective).","+","+Respond with ONLY the number 0 or 1:","+0 = NO DRIFT (The agent's intentions are aligned with and actively contributing to the Game Goal)","+1 = DRIFT DETECTED (The agent's intentions are disconnected, contradictory, or completely irrelevant to the Game Goal)","+\"\"\"","+MAX_DRIFT_JUDGE = 5   # cost cap: at most 5 drift probes judged per transcript","+","+# Shared, lazily-initialized judge. `state` is one of:","+#   \"unknown\" -> not yet probed; \"ok\" -> usable; anything else -> disabled note.","+_JUDGE = {\"model\": None, \"state\": \"unknown\", \"note\": \"\"}","+_JUDGE_LOCK = asyncio.Lock()","+","+","+async def _get_judge():","+    \"\"\"Return a working judge model, or None with a recorded reason.","+","+    Does a single preflight generate the first time it is called so that an","+    absent/invalid OPENROUTER_API_KEY disables the judge for the whole run","+    (drift=None everywhere) instead of failing 60 scans or burning API calls.","+    \"\"\"","+    async with _JUDGE_LOCK:","+        if _JUDGE[\"state\"] == \"ok\":","+            return _JUDGE[\"model\"]","+        if _JUDGE[\"state\"] != \"unknown\":","+            return None  # already determined unusable","+","+        if not os.environ.get(\"OPENROUTER_API_KEY\"):","+            _JUDGE[\"state\"] = \"no_key\"","+            _JUDGE[\"note\"] = \"OPENROUTER_API_KEY unset; drift judge skipped.\"","+            return None","+        try:","+            from inspect_ai.model import get_model","+            model = get_model(JUDGE_MODEL)","+            await _judge_one(model, \"test\", \"test\")  # preflight","+        except Exception as e:  # auth/connection/etc. -> disable gracefully","+            _JUDGE[\"state\"] = \"error\"","+            _JUDGE[\"note\"] = f\"drift judge unavailable ({type(e).__name__}: {e})\"","+            return None","+        _JUDGE[\"model\"] = model","+        _JUDGE[\"state\"] = \"ok\"","+        return model","+","+","+async def _judge_one(model, game_goal: str, intentions: str) -> int:","+    from inspect_ai.model import ChatMessageSystem, ChatMessageUser","+    if not intentions or not game_goal:","+        return 0","+    prompt = (f\"Game Goal:\\n{game_goal}\\n\\n\"","+              f\"Agent's Stated Intentions:\\n{intentions}\")","+    resp = await model.generate([","+        ChatMessageSystem(content=JUDGE_SYSTEM_PROMPT),","+        ChatMessageUser(content=prompt),","+    ])","+    return 1 if \"1\" in resp.completion.strip() else 0","+","+","+def _even_sample(items: list, k: int) -> list:","+    \"\"\"Evenly-spaced sample of at most k items (order preserved).\"\"\"","+    if len(items) <= k:","+        return items","+    step = len(items) / k","+    return [items[int(i * step)] for i in range(k)]","+","+","+async def _judge_drift(drift_probes: list) -> tuple:","+    \"\"\"Return (cumulative_drift or None, note). None => judge unavailable.\"\"\"","+    if not drift_probes:","+        return 0, \"\"","+    model = await _get_judge()","+    if model is None:","+        return None, _JUDGE[\"note\"]","+    sampled = _even_sample(drift_probes, MAX_DRIFT_JUDGE)","+    try:","+        scores = await asyncio.gather(*[","+            _judge_one(model, p[\"game_goal\"], p[\"completion\"]) for p in sampled","+        ])","+    except Exception as e:","+        return None, f\"drift judge failed mid-run ({type(e).__name__}: {e})\"","+    return sum(scores), f\"judged {len(sampled)}/{len(drift_probes)} drift probes\"","+","+"," @scanner(messages=\"all\")"," def cooking_rubric() -> Scanner[Transcript]:","     \"\"\"Score CookingWorld failure channels from harness telemetry.\"\"\""]},{"oldStart":111,"oldLines":18,"newStart":264,"newLines":26,"lines":["             )"," ","         r = _rubric(tele)","+        drift_probes = r.pop(\"drift_probes\")","         total_ale = r[\"ale_spatial\"] + r[\"ale_recipe\"]","+        drift, drift_note = await _judge_drift(drift_probes)","+","+        drift_str = \"None (skipped)\" if drift is None else str(drift)","         return Result(","             value=float(final_score),","             answer=(f\"score={final_score:.2f} | ALE={total_ale} \"","                     f\"(spatial {r['ale_spatial']}/recipe {r['ale_recipe']}) \"","                     f\"interface={r['interface']} liveness={r['liveness']} \"","-                    f\"info_seek={r['info_seek']} over {r['steps']} steps\"),","+                    f\"info_seek={r['info_seek']} integration={r['integration']} \"","+                    f\"drift={drift_str} over {r['steps']} steps\"),","             label=\"scored\",","             explanation=(f\"Failure-channel rubric over {r['steps']} steps. \"","-                         f\"Final game score {final_score:.3f}.\"),","+                         f\"Final game score {final_score:.3f}. \"","+                         f\"Drift: {drift_note or 'no drift probes'}.\"),","             metadata={\"final_score\": final_score, **r,","-                      \"total_ale\": total_ale},","+                      \"total_ale\": total_ale,","+                      \"drift\": drift, \"n_drift_probes\": len(drift_probes),","+                      \"drift_note\": drift_note},","         )"," ","     return scan"]}],"originalFile":"\"\"\"Scout scanner: failure-channel rubric for CookingWorld ablation eval logs.\n\nPorts dignissimus's per-step channel metrics (long-horizon-scaling\n`parse_ablation_results.py`) into an Inspect Scout scanner so the rubric is\nbrowsable in `scout view` and queryable via `scan_results_df`, instead of a\none-off pandas script.\n\nReads each transcript's `metadata['trajectory_telemetry']` (the per-step\n`probe_results` recorded by the harness during the eval run) and scores five\nfailure channels + final game score, emitting one Result per transcript.\n\nRun (from repo root, with the inspect venv):\n    .venv-inspect/bin/scout scan scout_report/cooking_rubric.py \\\n        -T flash_lite_eval_20260627_09354 --scans scout_report/scans\n\"\"\"\nimport string\n\nfrom inspect_scout import Result, Scanner, Transcript, scanner\n\n\n# --- ported verbatim from parse_ablation_results.py -------------------------\ndef clean_item_name(item: str) -> str:\n    item = item.lower().strip()\n    item = item.translate(str.maketrans(\"\", \"\", string.punctuation))\n    for p in (\"a \", \"an \", \"the \", \"some \"):\n        if item.startswith(p):\n            item = item[len(p):]\n    return item.strip()\n\n\ndef calculate_ale(completion: str, ground_truth: list) -> int:\n    \"\"\"Count hallucinated (FP) + forgotten (FN) items vs ground truth.\"\"\"\n    lines = [clean_item_name(x) for x in completion.split(\"\\n\") if x.strip()]\n    if len(lines) == 1 and lines[0] == \"nothing\":\n        lines = []\n    gt = [clean_item_name(x) for x in ground_truth]\n    errors = 0\n    for g in gt:                                  # false negatives (forgotten)\n        if not any(g in c for c in lines):\n            errors += 1\n    for c in lines:                               # false positives (hallucinated)\n        if not any(g in c for g in gt):\n            errors += 1\n    return errors\n\n\nPARSER_REJECTIONS = (\n    \"i don't understand\", \"that sentence isn't one i recognize\",\n    \"you can't see any such thing\", \"there is no\", \"i don't know the word\",\n    \"what do you want to\", \"nothing happens\",\n)\n\n\ndef _rubric(tele: list) -> dict:\n    \"\"\"Compute cumulative channel counts from trajectory telemetry.\"\"\"\n    ale_spatial = ale_recipe = interface = liveness = info_seek = 0\n    action_hist: list[str] = []\n    for step in tele:\n        action = (step.get(\"action_sent\") or \"\").strip()\n        valid = step.get(\"valid_actions\") or []\n        obs = (step.get(\"observation_received\") or \"\").lower()\n\n        for pr in step.get(\"probe_results\", []):\n            if pr.get(\"probe\") != \"ale\":\n                continue\n            comp = pr.get(\"completion\", \"\")\n            gt = (pr.get(\"metadata\") or {}).get(\"ground_truth\", []) or []\n            errs = calculate_ale(comp, gt)\n            qid = pr.get(\"id\", pr.get(\"question_id\", \"\"))\n            if str(qid).startswith(\"recipe\"):\n                ale_recipe += errs\n            else:\n                ale_spatial += errs\n\n        if action and valid and action not in valid:\n            interface += 1\n        action_hist.append(action)\n        if len(action_hist) >= 4 and len(set(action_hist[-4:])) == 1:\n            liveness += 1\n        if len(action_hist) >= 2:\n            prev = action_hist[-2]\n            if prev.startswith(\"go \") or prev.startswith(\"open door to\"):\n                if not any(action.startswith(p) for p in (\"look\", \"examine\", \"inventory\", \"read\")):\n                    info_seek += 1\n    return {\n        \"ale_spatial\": ale_spatial, \"ale_recipe\": ale_recipe,\n        \"interface\": interface, \"liveness\": liveness, \"info_seek\": info_seek,\n        \"steps\": len(tele),\n    }\n\n\n@scanner(messages=\"all\")\ndef cooking_rubric() -> Scanner[Transcript]:\n    \"\"\"Score CookingWorld failure channels from harness telemetry.\"\"\"\n\n    async def scan(transcript: Transcript) -> Result:\n        md = transcript.metadata or {}\n        # Inspect nests the eval sample's own metadata under \"sample_metadata\";\n        # the harness stored trajectory_telemetry + final_score there.\n        sm = md.get(\"sample_metadata\", md) or md\n        tele = sm.get(\"trajectory_telemetry\", []) or []\n        final_score = sm.get(\"final_score\", md.get(\"score_harness_scorer\", 0.0))\n\n        if not tele:\n            return Result(\n                value=float(final_score),\n                answer=\"no telemetry\",\n                label=\"no_telemetry\",\n                explanation=\"metadata carried no trajectory_telemetry; \"\n                            f\"available keys: {sorted(md.keys())[:12]}\",\n            )\n\n        r = _rubric(tele)\n        total_ale = r[\"ale_spatial\"] + r[\"ale_recipe\"]\n        return Result(\n            value=float(final_score),\n            answer=(f\"score={final_score:.2f} | ALE={total_ale} \"\n                    f\"(spatial {r['ale_spatial']}/recipe {r['ale_recipe']}) \"\n                    f\"interface={r['interface']} liveness={r['liveness']} \"\n                    f\"info_seek={r['info_seek']} over {r['steps']} steps\"),\n            label=\"scored\",\n            explanation=(f\"Failure-channel rubric over {r['steps']} steps. \"\n                         f\"Final game score {final_score:.3f}.\"),\n            metadata={\"final_score\": final_score, **r,\n                      \"total_ale\": total_ale},\n        )\n\n    return scan\n","userModified":false}}
