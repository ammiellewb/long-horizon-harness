{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VEbk1yoYcf4iF848UYx4Ev","type":"tool_result","content":"The file /Users/ammiellewambobecker/github/BASE Project/scout_report/report.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"fea65eed-6231-4aa0-9e3f-c41435ae29b8","uuid":"a08b8a9b-80b2-4f67-87d0-85947cad676c","timestamp":"2026-07-17T06:28:16.335Z","tool_use_result":{"filePath":"/Users/ammiellewambobecker/github/BASE Project/scout_report/report.py","oldString":"    df[\"config\"] = df[\"transcript_source_uri\"].map(_config)\n    df[\"final_score\"] = df[\"metadata\"].map(lambda m: _md(m, \"final_score\"))\n    for k in CHANNELS:\n        df[k] = df[\"metadata\"].map(lambda m, k=k: _md(m, k))\n    return df","newString":"    df[\"config\"] = df[\"transcript_source_uri\"].map(_config)\n    df[\"final_score\"] = df[\"metadata\"].map(lambda m: _md(m, \"final_score\"))\n    for k in CHANNELS:\n        default = None if k == \"drift\" else 0\n        df[k] = df[\"metadata\"].map(lambda m, k=k, d=default: _md(m, k, d))\n    df[\"drift_note\"] = df[\"metadata\"].map(lambda m: _md(m, \"drift_note\", \"\"))\n    return df\n\n\ndef drift_status(df: pd.DataFrame) -> str:\n    \"\"\"One-line summary of whether the LLM drift judge actually ran.\"\"\"\n    judged = df[\"drift\"].notna().sum()\n    notes = [n for n in df[\"drift_note\"].unique() if n and \"judged\" not in n]\n    if judged == len(df):\n        return f\"drift judge ran on all {judged} runs.\"\n    if notes:\n        return (f\"drift judge SKIPPED on {len(df) - df['drift'].notna().sum()} \"\n                f\"runs -> {notes[0]}\")\n    return f\"drift judged on {judged}/{len(df)} runs (others had no drift probes).\"","originalFile":"\"\"\"Aggregate the cooking_rubric Scout scan into a per-config report.\n\nReads the latest scan under scout_report/scans, groups the 60 per-transcript\nResults by ablation config, and prints score + failure-channel rates (raw and\nper-step normalized, since cumulative channel counts scale with episode length).\n\n    .venv-inspect/bin/python scout_report/report.py\n\"\"\"\nimport glob\nimport json\nimport os\nimport sys\n\nimport pandas as pd\n\nCONFIGS = [\"baseline-m5\", \"m3-m5\", \"m7-m5\", \"m5-m6\", \"m3-m5-m6\", \"m7-m5-m6\"]\nCHANNELS = [\"total_ale\", \"ale_spatial\", \"ale_recipe\", \"interface\", \"liveness\",\n            \"info_seek\", \"integration\", \"drift\", \"steps\"]\n\n\ndef _config(uri: str) -> str:\n    # match longest labels first so \"m3-m5\" doesn't shadow \"m3-m5-m6\"\n    for c in sorted(CONFIGS, key=len, reverse=True):\n        if c in str(uri):\n            return c\n    return \"?\"\n\n\ndef _md(cell, key, default=0):\n    if isinstance(cell, str):\n        try:\n            cell = json.loads(cell)\n        except Exception:\n            cell = {}\n    return (cell or {}).get(key, default) if isinstance(cell, dict) else default\n\n\ndef load(scan_dir: str | None = None) -> pd.DataFrame:\n    if scan_dir is None:\n        # scan_ids are random, so pick the most recently written scan by mtime\n        scans = glob.glob(\"scout_report/scans/scan_id=*\")\n        scan_dir = max(scans, key=os.path.getmtime)\n    df = pd.read_parquet(f\"{scan_dir}/cooking_rubric.parquet\")\n    df[\"config\"] = df[\"transcript_source_uri\"].map(_config)\n    df[\"final_score\"] = df[\"metadata\"].map(lambda m: _md(m, \"final_score\"))\n    for k in CHANNELS:\n        df[k] = df[\"metadata\"].map(lambda m, k=k: _md(m, k))\n    return df\n\n\ndef report(df: pd.DataFrame) -> pd.DataFrame:\n    g = df.groupby(\"config\").agg(\n        n=(\"value\", \"size\"),\n        score=(\"final_score\", \"mean\"),\n        ALE=(\"total_ale\", \"mean\"),\n        ALE_per_step=(\"total_ale\", \"sum\"),\n        interface=(\"interface\", \"mean\"),\n        liveness=(\"liveness\", \"mean\"),\n        info_seek=(\"info_seek\", \"mean\"),\n        integration=(\"integration\", \"mean\"),\n        drift=(\"drift\", \"mean\"),\n        steps=(\"steps\", \"mean\"),\n    )\n    # per-step ALE rate = total ALE / total steps (length-normalized)\n    tot = df.groupby(\"config\").agg(ale=(\"total_ale\", \"sum\"), st=(\"steps\", \"sum\"))\n    g[\"ALE_per_step\"] = (tot[\"ale\"] / tot[\"st\"]).round(2)\n    return g.reindex(CONFIGS).round(2)\n\n\nif __name__ == \"__main__\":\n    scan_dir = sys.argv[1] if len(sys.argv) > 1 else None\n    df = load(scan_dir)\n    pd.set_option(\"display.width\", 220)\n    print(f\"Scored {len(df)} runs across {df['config'].nunique()} configs \"\n          f\"(labels: {df['label'].value_counts().to_dict()})\\n\")\n    print(report(df).to_string())\n","structuredPatch":[{"oldStart":44,"oldLines":10,"newStart":44,"newLines":24,"lines":["     df[\"config\"] = df[\"transcript_source_uri\"].map(_config)","     df[\"final_score\"] = df[\"metadata\"].map(lambda m: _md(m, \"final_score\"))","     for k in CHANNELS:","-        df[k] = df[\"metadata\"].map(lambda m, k=k: _md(m, k))","+        default = None if k == \"drift\" else 0","+        df[k] = df[\"metadata\"].map(lambda m, k=k, d=default: _md(m, k, d))","+    df[\"drift_note\"] = df[\"metadata\"].map(lambda m: _md(m, \"drift_note\", \"\"))","     return df"," "," ","+def drift_status(df: pd.DataFrame) -> str:","+    \"\"\"One-line summary of whether the LLM drift judge actually ran.\"\"\"","+    judged = df[\"drift\"].notna().sum()","+    notes = [n for n in df[\"drift_note\"].unique() if n and \"judged\" not in n]","+    if judged == len(df):","+        return f\"drift judge ran on all {judged} runs.\"","+    if notes:","+        return (f\"drift judge SKIPPED on {len(df) - df['drift'].notna().sum()} \"","+                f\"runs -> {notes[0]}\")","+    return f\"drift judged on {judged}/{len(df)} runs (others had no drift probes).\"","+","+"," def report(df: pd.DataFrame) -> pd.DataFrame:","     g = df.groupby(\"config\").agg(","         n=(\"value\", \"size\"),"]}],"userModified":false,"replaceAll":false}}
