{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xz9ciD1C4UDTig7NvhwE4Q","type":"tool_result","content":"1\t\"\"\"Convert agent transcripts into a Scout TranscriptsDB.\n2\t\n3\tScout scanners operate on inspect_ai ChatMessage transcripts, so each input file is\n4\tmapped to one Scout Transcript (a list of messages) with gameplay metadata.\n5\t\n6\tTwo input formats are supported (dispatched by extension):\n7\t\n8\t  .json  TextQuests results (results/<run_id>/<model>/<game>.json) — messages come\n9\t         from history[]; metadata from logs[] and top-level score/progress/tokens.\n10\t\n11\t  .md    Structured markdown game transcripts (e.g. docs/transcript_sample.md):\n12\t         a metadata table + `## Turn NNN — TYPE` sections (REASONING / PLAN\n13\t         SYNTHESIS / ACTION), each with `### Subsection` blocks (System Prompt,\n14\t         Game Observation, Model Reasoning, New Plan, Action Chosen, ...). Each turn\n15\t         becomes a user message (env observation) + an assistant message (the model\n16\t         output for that turn type).\n17\t\n18\tUsage:\n19\t  python scout/convert.py --results results/baseline_no_clues --db scout/db\n20\t  python scout/convert.py --results docs --db scout/db          # markdown files\n21\t  python scout/convert.py --results docs/transcript_sample.md --db scout/db\n22\t\"\"\"\n23\timport argparse\n24\timport asyncio\n25\timport glob\n26\timport json\n27\timport os\n28\timport re\n29\t\n30\tfrom inspect_ai.model import (\n31\t    ChatMessageSystem,\n32\t    ChatMessageUser,\n33\t    ChatMessageAssistant,\n34\t)\n35\tfrom inspect_scout import Transcript, transcripts_db\n36\t\n37\t_ROLE_TO_MSG = {\n38\t    \"system\": ChatMessageSystem,\n39\t    \"user\": ChatMessageUser,\n40\t    \"assistant\": ChatMessageAssistant,\n41\t}\n42\t\n43\t\n44\tdef _to_messages(history: list[dict]):\n45\t    messages = []\n46\t    for m in history:\n47\t        cls = _ROLE_TO_MSG.get(m.get(\"role\"))\n48\t        if cls is None:\n49\t            continue\n50\t        content = m.get(\"content\", \"\")\n51\t        if not isinstance(content, str):\n52\t            content = json.dumps(content)\n53\t        messages.append(cls(content=content))\n54\t    return messages\n55\t\n56\t\n57\tdef _game_finished(progress, score, logs) -> bool:\n58\t    # mirrors play_textquests.game_finished (progress==100 or max score); we\n59\t    # don't have max_score here, so approximate with progress.\n60\t    return progress == 100\n61\t\n62\t\n63\tdef result_to_transcript(path: str, data: dict) -> Transcript:\n64\t    model = data.get(\"model\", \"unknown\")\n65\t    game = data.get(\"game_name\", os.path.splitext(os.path.basename(path))[0])\n66\t    run_id = data.get(\"run_id\") or os.path.basename(os.path.dirname(os.path.dirname(path)))\n67\t    logs = data.get(\"logs\", [])\n68\t    score = data.get(\"score\", 0)\n69\t    progress = data.get(\"progress\", 0)\n70\t    actions = [str(l.get(\"action\", \"\")) for l in logs]\n71\t\n72\t    messages = _to_messages(data.get(\"history\", []))\n73\t\n74\t    metadata = {\n75\t        \"game\": game,\n76\t        \"run_id\": run_id,\n77\t        \"with_clues\": data.get(\"with_clues\", False),\n78\t        \"steps\": data.get(\"steps\", len(logs)),\n79\t        \"max_steps\": data.get(\"max_steps\"),\n80\t        \"final_score\": score,\n81\t        \"final_progress\": progress,\n82\t        \"total_restore\": data.get(\"total_restore\", 0),\n83\t        \"token_usage\": data.get(\"token_usage\", {}),\n84\t        # cheap gameplay signals computed up front so scanners/filters can use them\n85\t        \"num_actions\": len(actions),\n86\t        \"num_unique_actions\": len(set(actions)),\n87\t        \"num_restore_actions\": sum(1 for a in actions if a.lower().startswith(\"restore\")),\n88\t    }\n89\t\n90\t    return Transcript(\n91\t        # keep id path-safe: Scout uses it in scan-buffer file paths\n92\t        transcript_id=f\"{run_id}__{model}__{game}\".replace(\"/\", \"-\"),\n93\t        source_type=\"textquests\",\n94\t        source_uri=os.path.abspath(path),\n95\t        agent=\"react\",\n96\t        model=model,\n97\t        score=score,\n98\t        success=_game_finished(progress, score, logs),\n99\t        message_count=len(messages),\n100\t        total_tokens=data.get(\"token_usage\", {})\n101\t        .get(\"all_token_usage\", {})\n102\t        .get(\"total_tokens\"),\n103\t        metadata=metadata,\n104\t        messages=messages,\n105\t    )\n106\t\n107\t\n108\t# ---------------------------------------------------------------------------\n109\t# Markdown transcripts (## Turn NNN — TYPE / ### Subsection)\n110\t# ---------------------------------------------------------------------------\n111\t\n112\t# which `### Subsection` holds the model's output, per turn type\n113\t_OUTPUT_SECTION = {\n114\t    \"REASONING\": \"Model Reasoning\",\n115\t    \"PLAN SYNTHESIS\": \"New Plan\",\n116\t    \"ACTION\": \"Action Chosen\",\n117\t}\n118\t# env-side sections to surface as the user message for each turn\n119\t_OBS_SECTIONS = [\"Game Observation\", \"Recipe (from cookbook)\", \"Admissible Actions\"]\n120\t\n121\t\n122\tdef _parse_md_table(text: str) -> dict:\n123\t    meta = {}\n124\t    for k, v in re.findall(r\"^\\|\\s*(.+?)\\s*\\|\\s*(.+?)\\s*\\|\\s*$\", text, re.M):\n125\t        key = k.strip().lower()\n126\t        if key in (\"field\", \"\") or set(v.strip()) <= {\"-\"}:\n127\t            continue\n128\t        meta[key] = v.strip()\n129\t    return meta\n130\t\n131\t\n132\tdef _parse_md_sections(body: str) -> dict:\n133\t    parts = re.split(r\"^###\\s+(.+?)\\s*$\", body, flags=re.M)\n134\t    sections = {}\n135\t    for i in range(1, len(parts) - 1, 2):\n136\t        sections[parts[i].strip()] = parts[i + 1].strip()\n137\t    return sections\n138\t\n139\t\n140\tdef _strip_code_fence(s: str) -> str:\n141\t    m = re.search(r\"```(?:\\w+)?\\n?(.*?)```\", s, re.DOTALL)\n142\t    return (m.group(1) if m else s).strip()\n143\t\n144\t\n145\tdef md_to_transcript(path: str, text: str) -> Transcript:\n146\t    header, *_ = re.split(r\"^## Turn \", text, maxsplit=1, flags=re.M)\n147\t    meta = _parse_md_table(header)\n148\t\n149\t    # split into (number, type, body) per turn\n150\t    turns = re.findall(\n151\t        r\"^## Turn\\s+(\\d+)\\s*[—-]\\s*([A-Z ]+?)\\s*$(.*?)(?=^## Turn |\\Z)\",\n152\t        text,\n153\t        flags=re.M | re.DOTALL,\n154\t    )\n155\t\n156\t    messages = []\n157\t    system_done = False\n158\t    actions = []\n159\t    type_counts = {}\n160\t\n161\t    for number, ttype, body in turns:\n162\t        ttype = ttype.strip()\n163\t        type_counts[ttype] = type_counts.get(ttype, 0) + 1\n164\t        secs = _parse_md_sections(body)\n165\t\n166\t        if not system_done and \"System Prompt\" in secs:\n167\t            messages.append(ChatMessageSystem(content=secs[\"System Prompt\"]))\n168\t            system_done = True\n169\t\n170\t        obs = \"\\n\\n\".join(\n171\t            f\"### {name}\\n{secs[name]}\" for name in _OBS_SECTIONS if name in secs\n172\t        )\n173\t        if obs:\n174\t            messages.append(ChatMessageUser(content=obs))\n175\t\n176\t        out_name = _OUTPUT_SECTION.get(ttype)\n177\t        out = secs.get(out_name, \"\") if out_name else \"\"\n178\t        if ttype == \"ACTION\":\n179\t            action = _strip_code_fence(out)\n180\t            actions.append(action)\n181\t            reasoning = secs.get(\"Reasoning Context\", \"\")\n182\t            content = (f\"{reasoning}\\n\\n\" if reasoning else \"\") + f\"Action: {action}\"\n183\t        else:\n184\t            content = out\n185\t        if content.strip():\n186\t            messages.append(ChatMessageAssistant(content=content))\n187\t\n188\t    max_run, run = (1, 1) if actions else (0, 0)\n189\t    for prev, cur in zip(actions, actions[1:]):\n190\t        run = run + 1 if cur == prev else 1\n191\t        max_run = max(max_run, run)\n192\t\n193\t    name = os.path.splitext(os.path.basename(path))[0]\n194\t    metadata = {\n195\t        \"source_file\": os.path.basename(path),\n196\t        \"turns\": len(turns),\n197\t        \"turn_type_counts\": type_counts,\n198\t        \"num_actions\": len(actions),\n199\t        \"num_unique_actions\": len(set(actions)),\n200\t        \"max_action_streak\": max_run,\n201\t        # header-table fields, prefixed to avoid Scout reserved column names\n202\t        **{f\"header_{k.replace(' ', '_')}\": v for k, v in meta.items()},\n203\t    }\n204\t    success = meta.get(\"success\", \"\").strip().lower()\n205\t    return Transcript(\n206\t        transcript_id=f\"md__{name}\".replace(\"/\", \"-\"),\n207\t        source_type=\"markdown\",\n208\t        source_uri=os.path.abspath(path),\n209\t        agent=\"react\",\n210\t        success=True if success in (\"yes\", \"true\", \"1\", \"success\") else None,\n211\t        message_count=len(messages),\n212\t        metadata=metadata,\n213\t        messages=messages,\n214\t    )\n215\t\n216\t\n217\tdef _path_to_transcript(path: str) -> Transcript | None:\n218\t    if path.endswith(\".md\"):\n219\t        with open(path) as f:\n220\t            text = f.read()\n221\t        if \"## Turn\" not in text:\n222\t            print(f\"  skip {path}: no '## Turn' sections\")\n223\t            return None\n224\t        return md_to_transcript(path, text)\n225\t    # .json (TextQuests)\n226\t    try:\n227\t        with open(path) as f:\n228\t            data = json.load(f)\n229\t    except (json.JSONDecodeError, OSError) as e:\n230\t        print(f\"  skip {path}: {e}\")\n231\t        return None\n232\t    if \"history\" not in data and \"logs\" not in data:\n233\t        return None  # not a TextQuests result file\n234\t    return result_to_transcript(path, data)\n235\t\n236\t\n237\tasync def build_db(results_dir: str, db_path: str) -> int:\n238\t    if os.path.isfile(results_dir):\n239\t        paths = [results_dir]\n240\t    else:\n241\t        paths = sorted(\n242\t            glob.glob(os.path.join(results_dir, \"**\", \"*.json\"), recursive=True)\n243\t            + glob.glob(os.path.join(results_dir, \"**\", \"*.md\"), recursive=True)\n244\t        )\n245\t\n246\t    transcripts = []\n247\t    for p in paths:\n248\t        t = _path_to_transcript(p)\n249\t        if t is None:\n250\t            continue\n251\t        transcripts.append(t)\n252\t        print(f\"  + {t.transcript_id} ({t.message_count} msgs)\")\n253\t\n254\t    if not transcripts:\n255\t        print(f\"No convertible transcripts found under {results_dir}\")\n256\t        return 0\n257\t\n258\t    db = transcripts_db(db_path)\n259\t    await db.connect()\n260\t    try:\n261\t        await db.insert(transcripts)\n262\t    finally:\n263\t        await db.disconnect()\n264\t    print(f\"\\nInserted {len(transcripts)} transcript(s) into {db_path}\")\n265\t    return len(transcripts)\n266\t\n267\t\n268\tif __name__ == \"__main__\":\n269\t    ap = argparse.ArgumentParser(description=__doc__)\n270\t    ap.add_argument(\"--results\", default=\"results\", help=\"results dir to scan for *.json\")\n271\t    ap.add_argument(\"--db\", default=\"scout/db\", help=\"output TranscriptsDB path\")\n272\t    args = ap.parse_args()\n273\t    asyncio.run(build_db(args.results, args.db))\n274\t"}]},"parent_tool_use_id":null,"session_id":"fea65eed-6231-4aa0-9e3f-c41435ae29b8","uuid":"52c54932-4e47-4e1e-9b4b-6041d04f73b0","timestamp":"2026-07-17T06:31:25.528Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ammiellewambobecker/github/BASE Project/base-project/textquests/scout/convert.py","content":"\"\"\"Convert agent transcripts into a Scout TranscriptsDB.\n\nScout scanners operate on inspect_ai ChatMessage transcripts, so each input file is\nmapped to one Scout Transcript (a list of messages) with gameplay metadata.\n\nTwo input formats are supported (dispatched by extension):\n\n  .json  TextQuests results (results/<run_id>/<model>/<game>.json) — messages come\n         from history[]; metadata from logs[] and top-level score/progress/tokens.\n\n  .md    Structured markdown game transcripts (e.g. docs/transcript_sample.md):\n         a metadata table + `## Turn NNN — TYPE` sections (REASONING / PLAN\n         SYNTHESIS / ACTION), each with `### Subsection` blocks (System Prompt,\n         Game Observation, Model Reasoning, New Plan, Action Chosen, ...). Each turn\n         becomes a user message (env observation) + an assistant message (the model\n         output for that turn type).\n\nUsage:\n  python scout/convert.py --results results/baseline_no_clues --db scout/db\n  python scout/convert.py --results docs --db scout/db          # markdown files\n  python scout/convert.py --results docs/transcript_sample.md --db scout/db\n\"\"\"\nimport argparse\nimport asyncio\nimport glob\nimport json\nimport os\nimport re\n\nfrom inspect_ai.model import (\n    ChatMessageSystem,\n    ChatMessageUser,\n    ChatMessageAssistant,\n)\nfrom inspect_scout import Transcript, transcripts_db\n\n_ROLE_TO_MSG = {\n    \"system\": ChatMessageSystem,\n    \"user\": ChatMessageUser,\n    \"assistant\": ChatMessageAssistant,\n}\n\n\ndef _to_messages(history: list[dict]):\n    messages = []\n    for m in history:\n        cls = _ROLE_TO_MSG.get(m.get(\"role\"))\n        if cls is None:\n            continue\n        content = m.get(\"content\", \"\")\n        if not isinstance(content, str):\n            content = json.dumps(content)\n        messages.append(cls(content=content))\n    return messages\n\n\ndef _game_finished(progress, score, logs) -> bool:\n    # mirrors play_textquests.game_finished (progress==100 or max score); we\n    # don't have max_score here, so approximate with progress.\n    return progress == 100\n\n\ndef result_to_transcript(path: str, data: dict) -> Transcript:\n    model = data.get(\"model\", \"unknown\")\n    game = data.get(\"game_name\", os.path.splitext(os.path.basename(path))[0])\n    run_id = data.get(\"run_id\") or os.path.basename(os.path.dirname(os.path.dirname(path)))\n    logs = data.get(\"logs\", [])\n    score = data.get(\"score\", 0)\n    progress = data.get(\"progress\", 0)\n    actions = [str(l.get(\"action\", \"\")) for l in logs]\n\n    messages = _to_messages(data.get(\"history\", []))\n\n    metadata = {\n        \"game\": game,\n        \"run_id\": run_id,\n        \"with_clues\": data.get(\"with_clues\", False),\n        \"steps\": data.get(\"steps\", len(logs)),\n        \"max_steps\": data.get(\"max_steps\"),\n        \"final_score\": score,\n        \"final_progress\": progress,\n        \"total_restore\": data.get(\"total_restore\", 0),\n        \"token_usage\": data.get(\"token_usage\", {}),\n        # cheap gameplay signals computed up front so scanners/filters can use them\n        \"num_actions\": len(actions),\n        \"num_unique_actions\": len(set(actions)),\n        \"num_restore_actions\": sum(1 for a in actions if a.lower().startswith(\"restore\")),\n    }\n\n    return Transcript(\n        # keep id path-safe: Scout uses it in scan-buffer file paths\n        transcript_id=f\"{run_id}__{model}__{game}\".replace(\"/\", \"-\"),\n        source_type=\"textquests\",\n        source_uri=os.path.abspath(path),\n        agent=\"react\",\n        model=model,\n        score=score,\n        success=_game_finished(progress, score, logs),\n        message_count=len(messages),\n        total_tokens=data.get(\"token_usage\", {})\n        .get(\"all_token_usage\", {})\n        .get(\"total_tokens\"),\n        metadata=metadata,\n        messages=messages,\n    )\n\n\n# ---------------------------------------------------------------------------\n# Markdown transcripts (## Turn NNN — TYPE / ### Subsection)\n# ---------------------------------------------------------------------------\n\n# which `### Subsection` holds the model's output, per turn type\n_OUTPUT_SECTION = {\n    \"REASONING\": \"Model Reasoning\",\n    \"PLAN SYNTHESIS\": \"New Plan\",\n    \"ACTION\": \"Action Chosen\",\n}\n# env-side sections to surface as the user message for each turn\n_OBS_SECTIONS = [\"Game Observation\", \"Recipe (from cookbook)\", \"Admissible Actions\"]\n\n\ndef _parse_md_table(text: str) -> dict:\n    meta = {}\n    for k, v in re.findall(r\"^\\|\\s*(.+?)\\s*\\|\\s*(.+?)\\s*\\|\\s*$\", text, re.M):\n        key = k.strip().lower()\n        if key in (\"field\", \"\") or set(v.strip()) <= {\"-\"}:\n            continue\n        meta[key] = v.strip()\n    return meta\n\n\ndef _parse_md_sections(body: str) -> dict:\n    parts = re.split(r\"^###\\s+(.+?)\\s*$\", body, flags=re.M)\n    sections = {}\n    for i in range(1, len(parts) - 1, 2):\n        sections[parts[i].strip()] = parts[i + 1].strip()\n    return sections\n\n\ndef _strip_code_fence(s: str) -> str:\n    m = re.search(r\"```(?:\\w+)?\\n?(.*?)```\", s, re.DOTALL)\n    return (m.group(1) if m else s).strip()\n\n\ndef md_to_transcript(path: str, text: str) -> Transcript:\n    header, *_ = re.split(r\"^## Turn \", text, maxsplit=1, flags=re.M)\n    meta = _parse_md_table(header)\n\n    # split into (number, type, body) per turn\n    turns = re.findall(\n        r\"^## Turn\\s+(\\d+)\\s*[—-]\\s*([A-Z ]+?)\\s*$(.*?)(?=^## Turn |\\Z)\",\n        text,\n        flags=re.M | re.DOTALL,\n    )\n\n    messages = []\n    system_done = False\n    actions = []\n    type_counts = {}\n\n    for number, ttype, body in turns:\n        ttype = ttype.strip()\n        type_counts[ttype] = type_counts.get(ttype, 0) + 1\n        secs = _parse_md_sections(body)\n\n        if not system_done and \"System Prompt\" in secs:\n            messages.append(ChatMessageSystem(content=secs[\"System Prompt\"]))\n            system_done = True\n\n        obs = \"\\n\\n\".join(\n            f\"### {name}\\n{secs[name]}\" for name in _OBS_SECTIONS if name in secs\n        )\n        if obs:\n            messages.append(ChatMessageUser(content=obs))\n\n        out_name = _OUTPUT_SECTION.get(ttype)\n        out = secs.get(out_name, \"\") if out_name else \"\"\n        if ttype == \"ACTION\":\n            action = _strip_code_fence(out)\n            actions.append(action)\n            reasoning = secs.get(\"Reasoning Context\", \"\")\n            content = (f\"{reasoning}\\n\\n\" if reasoning else \"\") + f\"Action: {action}\"\n        else:\n            content = out\n        if content.strip():\n            messages.append(ChatMessageAssistant(content=content))\n\n    max_run, run = (1, 1) if actions else (0, 0)\n    for prev, cur in zip(actions, actions[1:]):\n        run = run + 1 if cur == prev else 1\n        max_run = max(max_run, run)\n\n    name = os.path.splitext(os.path.basename(path))[0]\n    metadata = {\n        \"source_file\": os.path.basename(path),\n        \"turns\": len(turns),\n        \"turn_type_counts\": type_counts,\n        \"num_actions\": len(actions),\n        \"num_unique_actions\": len(set(actions)),\n        \"max_action_streak\": max_run,\n        # header-table fields, prefixed to avoid Scout reserved column names\n        **{f\"header_{k.replace(' ', '_')}\": v for k, v in meta.items()},\n    }\n    success = meta.get(\"success\", \"\").strip().lower()\n    return Transcript(\n        transcript_id=f\"md__{name}\".replace(\"/\", \"-\"),\n        source_type=\"markdown\",\n        source_uri=os.path.abspath(path),\n        agent=\"react\",\n        success=True if success in (\"yes\", \"true\", \"1\", \"success\") else None,\n        message_count=len(messages),\n        metadata=metadata,\n        messages=messages,\n    )\n\n\ndef _path_to_transcript(path: str) -> Transcript | None:\n    if path.endswith(\".md\"):\n        with open(path) as f:\n            text = f.read()\n        if \"## Turn\" not in text:\n            print(f\"  skip {path}: no '## Turn' sections\")\n            return None\n        return md_to_transcript(path, text)\n    # .json (TextQuests)\n    try:\n        with open(path) as f:\n            data = json.load(f)\n    except (json.JSONDecodeError, OSError) as e:\n        print(f\"  skip {path}: {e}\")\n        return None\n    if \"history\" not in data and \"logs\" not in data:\n        return None  # not a TextQuests result file\n    return result_to_transcript(path, data)\n\n\nasync def build_db(results_dir: str, db_path: str) -> int:\n    if os.path.isfile(results_dir):\n        paths = [results_dir]\n    else:\n        paths = sorted(\n            glob.glob(os.path.join(results_dir, \"**\", \"*.json\"), recursive=True)\n            + glob.glob(os.path.join(results_dir, \"**\", \"*.md\"), recursive=True)\n        )\n\n    transcripts = []\n    for p in paths:\n        t = _path_to_transcript(p)\n        if t is None:\n            continue\n        transcripts.append(t)\n        print(f\"  + {t.transcript_id} ({t.message_count} msgs)\")\n\n    if not transcripts:\n        print(f\"No convertible transcripts found under {results_dir}\")\n        return 0\n\n    db = transcripts_db(db_path)\n    await db.connect()\n    try:\n        await db.insert(transcripts)\n    finally:\n        await db.disconnect()\n    print(f\"\\nInserted {len(transcripts)} transcript(s) into {db_path}\")\n    return len(transcripts)\n\n\nif __name__ == \"__main__\":\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument(\"--results\", default=\"results\", help=\"results dir to scan for *.json\")\n    ap.add_argument(\"--db\", default=\"scout/db\", help=\"output TranscriptsDB path\")\n    args = ap.parse_args()\n    asyncio.run(build_db(args.results, args.db))\n","numLines":274,"startLine":1,"totalLines":274}}}
