{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N65FKUadu8og4XycHt4jFj","type":"tool_result","content":"The file /Users/ammiellewambobecker/github/BASE Project/scout_report/report.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"fea65eed-6231-4aa0-9e3f-c41435ae29b8","uuid":"a2423a4d-d20c-4e7b-af86-db8a861d9f19","timestamp":"2026-07-17T06:28:21.476Z","tool_use_result":{"filePath":"/Users/ammiellewambobecker/github/BASE Project/scout_report/report.py","oldString":"    print(f\"Scored {len(df)} runs across {df['config'].nunique()} configs \"\n          f\"(labels: {df['label'].value_counts().to_dict()})\\n\")\n    print(report(df).to_string())","newString":"    print(f\"Scored {len(df)} runs across {df['config'].nunique()} configs \"\n          f\"(labels: {df['label'].value_counts().to_dict()})\")\n    print(drift_status(df) + \"\\n\")\n    print(report(df).to_string())","originalFile":"\"\"\"Aggregate the cooking_rubric Scout scan into a per-config report.\n\nReads the latest scan under scout_report/scans, groups the 60 per-transcript\nResults by ablation config, and prints score + failure-channel rates (raw and\nper-step normalized, since cumulative channel counts scale with episode length).\n\n    .venv-inspect/bin/python scout_report/report.py\n\"\"\"\nimport glob\nimport json\nimport os\nimport sys\n\nimport pandas as pd\n\nCONFIGS = [\"baseline-m5\", \"m3-m5\", \"m7-m5\", \"m5-m6\", \"m3-m5-m6\", \"m7-m5-m6\"]\nCHANNELS = [\"total_ale\", \"ale_spatial\", \"ale_recipe\", \"interface\", \"liveness\",\n            \"info_seek\", \"integration\", \"drift\", \"steps\"]\n\n\ndef _config(uri: str) -> str:\n    # match longest labels first so \"m3-m5\" doesn't shadow \"m3-m5-m6\"\n    for c in sorted(CONFIGS, key=len, reverse=True):\n        if c in str(uri):\n            return c\n    return \"?\"\n\n\ndef _md(cell, key, default=0):\n    if isinstance(cell, str):\n        try:\n            cell = json.loads(cell)\n        except Exception:\n            cell = {}\n    return (cell or {}).get(key, default) if isinstance(cell, dict) else default\n\n\ndef load(scan_dir: str | None = None) -> pd.DataFrame:\n    if scan_dir is None:\n        # scan_ids are random, so pick the most recently written scan by mtime\n        scans = glob.glob(\"scout_report/scans/scan_id=*\")\n        scan_dir = max(scans, key=os.path.getmtime)\n    df = pd.read_parquet(f\"{scan_dir}/cooking_rubric.parquet\")\n    df[\"config\"] = df[\"transcript_source_uri\"].map(_config)\n    df[\"final_score\"] = df[\"metadata\"].map(lambda m: _md(m, \"final_score\"))\n    for k in CHANNELS:\n        default = None if k == \"drift\" else 0\n        df[k] = df[\"metadata\"].map(lambda m, k=k, d=default: _md(m, k, d))\n    df[\"drift_note\"] = df[\"metadata\"].map(lambda m: _md(m, \"drift_note\", \"\"))\n    return df\n\n\ndef drift_status(df: pd.DataFrame) -> str:\n    \"\"\"One-line summary of whether the LLM drift judge actually ran.\"\"\"\n    judged = df[\"drift\"].notna().sum()\n    notes = [n for n in df[\"drift_note\"].unique() if n and \"judged\" not in n]\n    if judged == len(df):\n        return f\"drift judge ran on all {judged} runs.\"\n    if notes:\n        return (f\"drift judge SKIPPED on {len(df) - df['drift'].notna().sum()} \"\n                f\"runs -> {notes[0]}\")\n    return f\"drift judged on {judged}/{len(df)} runs (others had no drift probes).\"\n\n\ndef report(df: pd.DataFrame) -> pd.DataFrame:\n    g = df.groupby(\"config\").agg(\n        n=(\"value\", \"size\"),\n        score=(\"final_score\", \"mean\"),\n        ALE=(\"total_ale\", \"mean\"),\n        ALE_per_step=(\"total_ale\", \"sum\"),\n        interface=(\"interface\", \"mean\"),\n        liveness=(\"liveness\", \"mean\"),\n        info_seek=(\"info_seek\", \"mean\"),\n        integration=(\"integration\", \"mean\"),\n        drift=(\"drift\", \"mean\"),\n        steps=(\"steps\", \"mean\"),\n    )\n    # per-step ALE rate = total ALE / total steps (length-normalized)\n    tot = df.groupby(\"config\").agg(ale=(\"total_ale\", \"sum\"), st=(\"steps\", \"sum\"))\n    g[\"ALE_per_step\"] = (tot[\"ale\"] / tot[\"st\"]).round(2)\n    return g.reindex(CONFIGS).round(2)\n\n\nif __name__ == \"__main__\":\n    scan_dir = sys.argv[1] if len(sys.argv) > 1 else None\n    df = load(scan_dir)\n    pd.set_option(\"display.width\", 220)\n    print(f\"Scored {len(df)} runs across {df['config'].nunique()} configs \"\n          f\"(labels: {df['label'].value_counts().to_dict()})\\n\")\n    print(report(df).to_string())\n","structuredPatch":[{"oldStart":86,"oldLines":5,"newStart":86,"newLines":6,"lines":["     df = load(scan_dir)","     pd.set_option(\"display.width\", 220)","     print(f\"Scored {len(df)} runs across {df['config'].nunique()} configs \"","-          f\"(labels: {df['label'].value_counts().to_dict()})\\n\")","+          f\"(labels: {df['label'].value_counts().to_dict()})\")","+    print(drift_status(df) + \"\\n\")","     print(report(df).to_string())"]}],"userModified":false,"replaceAll":false}}
