{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RDdvxHFg3jXbt7vbRPSjvK","type":"tool_result","content":"1\t\"\"\"Aggregate the cooking_rubric Scout scan into a per-config report.\n2\t\n3\tReads the latest scan under scout_report/scans, groups the 60 per-transcript\n4\tResults by ablation config, and prints score + failure-channel rates (raw and\n5\tper-step normalized, since cumulative channel counts scale with episode length).\n6\t\n7\t    .venv-inspect/bin/python scout_report/report.py\n8\t\"\"\"\n9\timport glob\n10\timport json\n11\timport sys\n12\t\n13\timport pandas as pd\n14\t\n15\tCONFIGS = [\"baseline-m5\", \"m3-m5\", \"m7-m5\", \"m5-m6\", \"m3-m5-m6\", \"m7-m5-m6\"]\n16\tCHANNELS = [\"total_ale\", \"ale_spatial\", \"ale_recipe\", \"interface\", \"liveness\", \"info_seek\", \"steps\"]\n17\t\n18\t\n19\tdef _config(uri: str) -> str:\n20\t    # match longest labels first so \"m3-m5\" doesn't shadow \"m3-m5-m6\"\n21\t    for c in sorted(CONFIGS, key=len, reverse=True):\n22\t        if c in str(uri):\n23\t            return c\n24\t    return \"?\"\n25\t\n26\t\n27\tdef _md(cell, key, default=0):\n28\t    if isinstance(cell, str):\n29\t        try:\n30\t            cell = json.loads(cell)\n31\t        except Exception:\n32\t            cell = {}\n33\t    return (cell or {}).get(key, default) if isinstance(cell, dict) else default\n34\t\n35\t\n36\tdef load(scan_dir: str | None = None) -> pd.DataFrame:\n37\t    if scan_dir is None:\n38\t        scan_dir = sorted(glob.glob(\"scout_report/scans/scan_id=*\"))[-1]\n39\t    df = pd.read_parquet(f\"{scan_dir}/cooking_rubric.parquet\")\n40\t    df[\"config\"] = df[\"transcript_source_uri\"].map(_config)\n41\t    df[\"final_score\"] = df[\"metadata\"].map(lambda m: _md(m, \"final_score\"))\n42\t    for k in CHANNELS:\n43\t        df[k] = df[\"metadata\"].map(lambda m, k=k: _md(m, k))\n44\t    return df\n45\t\n46\t\n47\tdef report(df: pd.DataFrame) -> pd.DataFrame:\n48\t    g = df.groupby(\"config\").agg(\n49\t        n=(\"value\", \"size\"),\n50\t        score=(\"final_score\", \"mean\"),\n51\t        ALE=(\"total_ale\", \"mean\"),\n52\t        ALE_per_step=(\"total_ale\", \"sum\"),\n53\t        interface=(\"interface\", \"mean\"),\n54\t        liveness=(\"liveness\", \"mean\"),\n55\t        steps=(\"steps\", \"mean\"),\n56\t    )\n57\t    # per-step ALE rate = total ALE / total steps (length-normalized)\n58\t    tot = df.groupby(\"config\").agg(ale=(\"total_ale\", \"sum\"), st=(\"steps\", \"sum\"))\n59\t    g[\"ALE_per_step\"] = (tot[\"ale\"] / tot[\"st\"]).round(2)\n60\t    return g.reindex(CONFIGS).round(2)\n61\t\n62\t\n63\tif __name__ == \"__main__\":\n64\t    scan_dir = sys.argv[1] if len(sys.argv) > 1 else None\n65\t    df = load(scan_dir)\n66\t    pd.set_option(\"display.width\", 220)\n67\t    print(f\"Scored {len(df)} runs across {df['config'].nunique()} configs \"\n68\t          f\"(labels: {df['label'].value_counts().to_dict()})\\n\")\n69\t    print(report(df).to_string())\n70\t"}]},"parent_tool_use_id":null,"session_id":"fea65eed-6231-4aa0-9e3f-c41435ae29b8","uuid":"756e99d1-4989-4dfd-a046-24d8d6911878","timestamp":"2026-07-17T06:21:50.018Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ammiellewambobecker/github/BASE Project/scout_report/report.py","content":"\"\"\"Aggregate the cooking_rubric Scout scan into a per-config report.\n\nReads the latest scan under scout_report/scans, groups the 60 per-transcript\nResults by ablation config, and prints score + failure-channel rates (raw and\nper-step normalized, since cumulative channel counts scale with episode length).\n\n    .venv-inspect/bin/python scout_report/report.py\n\"\"\"\nimport glob\nimport json\nimport sys\n\nimport pandas as pd\n\nCONFIGS = [\"baseline-m5\", \"m3-m5\", \"m7-m5\", \"m5-m6\", \"m3-m5-m6\", \"m7-m5-m6\"]\nCHANNELS = [\"total_ale\", \"ale_spatial\", \"ale_recipe\", \"interface\", \"liveness\", \"info_seek\", \"steps\"]\n\n\ndef _config(uri: str) -> str:\n    # match longest labels first so \"m3-m5\" doesn't shadow \"m3-m5-m6\"\n    for c in sorted(CONFIGS, key=len, reverse=True):\n        if c in str(uri):\n            return c\n    return \"?\"\n\n\ndef _md(cell, key, default=0):\n    if isinstance(cell, str):\n        try:\n            cell = json.loads(cell)\n        except Exception:\n            cell = {}\n    return (cell or {}).get(key, default) if isinstance(cell, dict) else default\n\n\ndef load(scan_dir: str | None = None) -> pd.DataFrame:\n    if scan_dir is None:\n        scan_dir = sorted(glob.glob(\"scout_report/scans/scan_id=*\"))[-1]\n    df = pd.read_parquet(f\"{scan_dir}/cooking_rubric.parquet\")\n    df[\"config\"] = df[\"transcript_source_uri\"].map(_config)\n    df[\"final_score\"] = df[\"metadata\"].map(lambda m: _md(m, \"final_score\"))\n    for k in CHANNELS:\n        df[k] = df[\"metadata\"].map(lambda m, k=k: _md(m, k))\n    return df\n\n\ndef report(df: pd.DataFrame) -> pd.DataFrame:\n    g = df.groupby(\"config\").agg(\n        n=(\"value\", \"size\"),\n        score=(\"final_score\", \"mean\"),\n        ALE=(\"total_ale\", \"mean\"),\n        ALE_per_step=(\"total_ale\", \"sum\"),\n        interface=(\"interface\", \"mean\"),\n        liveness=(\"liveness\", \"mean\"),\n        steps=(\"steps\", \"mean\"),\n    )\n    # per-step ALE rate = total ALE / total steps (length-normalized)\n    tot = df.groupby(\"config\").agg(ale=(\"total_ale\", \"sum\"), st=(\"steps\", \"sum\"))\n    g[\"ALE_per_step\"] = (tot[\"ale\"] / tot[\"st\"]).round(2)\n    return g.reindex(CONFIGS).round(2)\n\n\nif __name__ == \"__main__\":\n    scan_dir = sys.argv[1] if len(sys.argv) > 1 else None\n    df = load(scan_dir)\n    pd.set_option(\"display.width\", 220)\n    print(f\"Scored {len(df)} runs across {df['config'].nunique()} configs \"\n          f\"(labels: {df['label'].value_counts().to_dict()})\\n\")\n    print(report(df).to_string())\n","numLines":70,"startLine":1,"totalLines":70}}}
